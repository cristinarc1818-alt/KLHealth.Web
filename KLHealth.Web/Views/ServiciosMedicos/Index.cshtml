@model KLHealth.Web.Models.ViewModels.ServiciosMedicosViewModel
@{
    Layout = "_LayoutAdmin";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700);">Servicios Médicos</h1>
    <p class="text-muted mb-0">Catálogo de servicios y especialidades disponibles.</p>
</div>

<!-- Filtros por especialidad -->
<div class="mb-4">
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Index", "ServiciosMedicos")" class="filter-tab @(string.IsNullOrEmpty(Model.EspecialidadFiltro) ? "active" : "")">
            Todas las Especialidades
        </a>
        <a href="@Url.Action("Index", "ServiciosMedicos", new { especialidad = "Medicina General" })" class="filter-tab @(Model.EspecialidadFiltro == "Medicina General" ? "active" : "")">
            Medicina General
        </a>
        <a href="@Url.Action("Index", "ServiciosMedicos", new { especialidad = "Cardiología" })" class="filter-tab @(Model.EspecialidadFiltro == "Cardiología" ? "active" : "")">
            Cardiología
        </a>
        <a href="@Url.Action("Index", "ServiciosMedicos", new { especialidad = "Pediatría" })" class="filter-tab @(Model.EspecialidadFiltro == "Pediatría" ? "active" : "")">
            Pediatría
        </a>
        <a href="@Url.Action("Index", "ServiciosMedicos", new { especialidad = "Dermatología" })" class="filter-tab @(Model.EspecialidadFiltro == "Dermatología" ? "active" : "")">
            Dermatología
        </a>
    </div>
</div>

<!-- Grid de servicios -->
<div class="row g-4">
    @if (Model.Servicios.Any())
    {
        @foreach (var servicio in Model.Servicios)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 14px;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 50px; height: 50px; background: #dbeafe; color: var(--blue-700);">
                                <i class="bi bi-person-badge" style="font-size: 1.5rem;"></i>
                            </div>
                            @if (servicio.Disponible)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">No Disponible</span>
                            }
                        </div>

                        <!-- CORRECCIÓN 1: Nombre sin duplicar título -->
                        <h5 class="fw-bold mb-2" style="color: #0f172a; font-size: 1.1rem;">@servicio.Nombre</h5>
                        <p class="text-muted small mb-3">@servicio.Especialidad</p>

                        @if (!string.IsNullOrEmpty(servicio.Descripcion))
                        {
                            <p class="small text-muted mb-3" style="line-height: 1.6;">
                                @servicio.Descripcion.Substring(0, Math.Min(100, servicio.Descripcion.Length))...
                            </p>
                        }

                        <div class="d-flex justify-content-between align-items-center pt-3" style="border-top: 1px solid #e2e8f0;">
                            <div>
                                <small class="text-muted">Precio consulta</small>
                                <!-- CORRECCIÓN 2: Mostrar precio real o "Consultar" -->
                                <div class="fw-bold" style="color: var(--blue-700); font-size: 1.25rem;">
                                    @(servicio.Precio > 0 ? "$" + servicio.Precio.ToString("0.00") : "Consultar")
                                </div>
                            </div>
                            <!-- CORRECCIÓN 3: Botón con funcionalidad -->
                            <a href="@Url.Action("Index", "AdminMedicos", new { id = servicio.Id })"
                               class="btn btn-sm btn-outline-primary"
                               style="border-radius: 8px;">
                                Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="text-center py-5">
                <i class="bi bi-briefcase" style="font-size: 4rem; color: #cbd5e1;"></i>
                <h5 class="fw-bold mt-3 mb-2">No hay servicios disponibles</h5>
                <p class="text-muted">No se encontraron servicios médicos @(string.IsNullOrEmpty(Model.EspecialidadFiltro) ? "" : $"en {Model.EspecialidadFiltro}")</p>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .filter-tab {
            padding: 0.6rem 1.2rem;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            color: #475569;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .filter-tab:hover {
                background: #f8fafc;
                color: var(--blue-700);
                text-decoration: none;
            }

            .filter-tab.active {
                background: var(--blue-900);
                border-color: var(--blue-900);
                color: white;
            }
    </style>
}