@model KLHealth.Web.Models.ViewModels.AdminDashboardViewModel
@{
    Layout = "_LayoutAdmin";
}

<!-- Header de Bienvenida -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700); letter-spacing: -0.5px;">Buenos Días, @Model.AdminName</h1>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Esto es lo que está sucediendo en K & L Health hoy.</p>
    </div>
    <div class="text-end">
        <div class="text-muted small fw-medium" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Estado del Hospital</div>
        <div class="fw-bold text-dark" style="font-size: 0.9rem;">
            <i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i> Capacidad Operativa: 84%
        </div>
    </div>
</div>

<!-- KPIs - 4 tarjetas -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card-admin border-0 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="kpi-icon-admin bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill" style="font-size: 0.7rem;">+12%</span>
                </div>
                <div class="text-muted small mb-1" style="font-size: 0.75rem;">Total de Pacientes</div>
                <div class="fw-bold text-dark mb-2" style="font-size: 1.5rem;">@Model.TotalPacientes.ToString("N0")</div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: 75%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card-admin border-0 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="kpi-icon-admin bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill" style="font-size: 0.7rem;">En Tiempo</span>
                </div>
                <div class="text-muted small mb-1" style="font-size: 0.75rem;">Citas de Hoy</div>
                <div class="fw-bold text-dark mb-2" style="font-size: 1.5rem;">@Model.CitasHoy</div>
                <div class="d-flex gap-1 align-items-end" style="height: 20px;">
                    <div style="width: 12px; height: 40%; background: #bbf7d0; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 60%; background: #86efac; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 80%; background: #4ade80; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 50%; background: #bbf7d0; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 70%; background: #86efac; border-radius: 2px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card-admin border-0 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="kpi-icon-admin bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="bi bi-stethoscope"></i>
                    </div>
                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill" style="font-size: 0.7rem;">-2</span>
                </div>
                <div class="text-muted small mb-1" style="font-size: 0.75rem;">Médicos de Guardia</div>
                <div class="fw-bold text-dark mb-2" style="font-size: 1.5rem;">@Model.MedicosGuardia</div>
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex">
                        <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--blue-100); border: 2px solid white; margin-left: -8px;"></div>
                        <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--blue-200); border: 2px solid white; margin-left: -8px;"></div>
                        <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--blue-50); border: 2px solid white; margin-left: -8px;"></div>
                    </div>
                    <span class="text-muted small" style="font-size: 0.7rem;">+15</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 h-100" style="background: var(--blue-900); color: white;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="kpi-icon-admin" style="background: rgba(255,255,255,0.2); color: white;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <span class="badge" style="background: rgba(255,255,255,0.2); color: white; font-size: 0.7rem;">Meta Diaria</span>
                </div>
                <div class="small mb-1" style="font-size: 0.75rem; opacity: 0.9;">Ingresos de Hoy</div>
                <div class="fw-bold mb-2" style="font-size: 1.5rem;">$@Model.IngresosHoy.ToString("N0")</div>
                <div class="small" style="font-size: 0.75rem; opacity: 0.9;">
                    <i class="bi bi-arrow-up-right"></i> @Model.IngresosCambio.ToString("N1")% más que ayer
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Columna Izquierda -->
    <div class="col-lg-8">
        <!-- Próximas Citas -->
        <div class="card border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0" style="font-size: 1.05rem;">Próximas Citas</h5>
                    <a href="@Url.Action("Index", "AdminCitas")" class="text-decoration-none fw-semibold" style="color: var(--blue-700); font-size: 0.85rem;">Ver Todo</a>
                </div>

                @if (Model.ProximasCitas != null && Model.ProximasCitas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; border: none;">Paciente</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; border: none;">Hora</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; border: none;">Especialidad</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; border: none;">Estado</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; border: none;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cita in Model.ProximasCitas)
                                {
                                    // Lógica directa en C# sin @{ } para evitar errores de Razor
                                    var nombreCompleto = cita.Paciente?.Usuario?.NombreCompleto ?? "Usuario";
                                    var palabras = nombreCompleto.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                    var primeraLetra = palabras.Length > 0 && palabras[0].Length > 0 ? palabras[0][0] : '?';
                                    var segundaLetra = palabras.Length > 1 && palabras[1].Length > 0 ? palabras[1][0] : '?';
                                    var iniciales = $"{primeraLetra}{segundaLetra}".ToUpper();

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-circle">@iniciales</div>
                                                <div>
                                                    <div class="fw-semibold text-dark" style="font-size: 0.9rem;">@(cita.Paciente?.Usuario?.NombreCompleto ?? "Desconocido")</div>
                                                    <div class="text-muted" style="font-size: 0.72rem;">ID: #@cita.Paciente?.NumeroIdentificacion</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@cita.FechaHoraInicio.ToString("hh:mm tt")</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@cita.Sala</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill" style="font-size: 0.72rem; font-weight: 500;">
                                                @(cita.Medico?.Especialidad?.Nombre ?? "General")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill px-3 py-2 @(cita.Estado == "Confirmada" ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")" style="font-size: 0.72rem;">
                                                @cita.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Detalles", "AdminCitas", new { id = cita.Id })" class="btn btn-sm btn-link text-muted p-0" title="Ver detalles">
                                                <i class="bi bi-three-dots"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x" style="font-size: 2.5rem; color: var(--text-light); opacity: 0.5;"></i>
                        <p class="text-muted mt-3 mb-0" style="font-size: 0.9rem;">No hay citas programadas próximamente.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Tendencias de Crecimiento -->
        <div class="card border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h5 class="fw-bold mb-1" style="font-size: 1.05rem;">Tendencias de Crecimiento</h5>
                        <p class="text-muted mb-0 small">Análisis mensual de adquisición y retención de pacientes</p>
                    </div>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active">12 Meses</button>
                        <button type="button" class="btn btn-outline-primary">6 Meses</button>
                    </div>
                </div>

                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="chartTendencias"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Derecha -->
    <div class="col-lg-4">
        <!-- Acciones Rápidas -->
        <div class="card border-0 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">Acciones Rápidas</h5>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Crear", "AdminPacientes")" class="btn py-2 d-flex align-items-center justify-content-between px-3 action-btn-primary" style="border-radius: 10px; font-size: 0.88rem; font-weight: 500; text-decoration: none; color: white; background: var(--blue-900);">
                        <span><i class="bi bi-person-plus me-2"></i>Nuevo Paciente</span>
                        <i class="bi bi-chevron-right" style="font-size: 0.8rem;"></i>
                    </a>
                    <a href="@Url.Action("Agendar", "Citas")" class="btn py-2 d-flex align-items-center justify-content-between px-3 action-btn-secondary" style="border-radius: 10px; font-size: 0.88rem; font-weight: 500; text-decoration: none; color: var(--blue-900); background: #dbeafe;">
                        <span><i class="bi bi-calendar-plus me-2"></i>Agendar Cita</span>
                        <i class="bi bi-chevron-right" style="font-size: 0.8rem;"></i>
                    </a>
                    <button class="btn py-2 d-flex align-items-center justify-content-between px-3 action-btn-tertiary" style="border-radius: 10px; font-size: 0.88rem; font-weight: 500; background: #f8fafc; border: 1px solid #e2e8f0;">
                        <span><i class="bi bi-file-earmark-bar-graph me-2"></i>Generar Informe</span>
                        <i class="bi bi-chevron-right" style="font-size: 0.8rem;"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Demografía -->
        <div class="card border-0 mb-4">
            <div class="card-body p-4 text-center">
                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">Demografía</h5>
                <div class="position-relative mb-3" style="width: 180px; height: 180px; margin: 0 auto;">
                    <canvas id="chartDemografia" style="max-height: 180px;"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <div class="fw-bold text-dark" style="font-size: 1.5rem;">1.2k</div>
                        <div class="text-muted small" style="font-size: 0.7rem;">TOTAL ACTIVOS</div>
                    </div>
                </div>
                <div class="d-flex justify-content-center gap-4 mt-3">
                    <div class="text-start">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--blue-700);"></div>
                            <span class="small text-muted">Adultos</span>
                        </div>
                        <div class="fw-bold" style="font-size: 0.9rem;">60%</div>
                    </div>
                    <div class="text-start">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: #86efac;"></div>
                            <span class="small text-muted">Niños</span>
                        </div>
                        <div class="fw-bold" style="font-size: 0.9rem;">25%</div>
                    </div>
                    <div class="text-start">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--blue-100);"></div>
                            <span class="small text-muted">Mayores</span>
                        </div>
                        <div class="fw-bold" style="font-size: 0.9rem;">15%</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actividad Reciente -->
        <div class="card border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="font-size: 1.05rem;">Actividad Reciente</h5>
                    <button class="btn btn-sm btn-link text-muted p-0">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex gap-3">
                        <div class="activity-icon bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-file-earmark-medical"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark small">Resultados Listos</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Paciente: Michael Ross (Analítica)</div>
                            <div class="text-muted" style="font-size: 0.7rem; margin-top: 0.25rem;">HACE 2 MINUTOS</div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="activity-icon bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-primary small">Llegada de Emergencia</div>
                            <div class="text-muted" style="font-size: 0.75rem;">ETA Ambulancia: 5 min (Trauma)</div>
                            <div class="text-muted" style="font-size: 0.7rem; margin-top: 0.25rem;">HACE 12 MINUTOS</div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="activity-icon bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark small">Nueva Reserva</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Paciente: Linda Wu (Ortopedia)</div>
                            <div class="text-muted" style="font-size: 0.7rem; margin-top: 0.25rem;">HACE 45 MINUTOS</div>
                        </div>
                    </div>
                </div>

                <a href="@Url.Action("Index", "Notificaciones")" class="btn btn-outline-secondary w-100 mt-3 py-2" style="font-size: 0.85rem; border-radius: 8px; text-decoration: none;">
                    Ver todas las notificaciones
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Botón Flotante -->
<a href="@Url.Action("Agendar", "Citas")" class="btn-floating-action" title="Acción rápida" style="position: fixed; bottom: 2rem; right: 2rem; width: 56px; height: 56px; border-radius: 50%; background: var(--blue-900); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; text-decoration: none; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3); z-index: 1000;">
    <i class="bi bi-plus"></i>
</a>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Gráfico de Tendencias de Crecimiento
            const ctxTendencias = document.getElementById('chartTendencias');
            if (ctxTendencias) {
                const datosTendencias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DatosTendencias ?? new List<int>()));
                const meses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meses ?? new List<string>()));

                new Chart(ctxTendencias, {
                    type: 'bar',
                    data: {
                        labels: meses,
                        datasets: [{
                            label: 'Pacientes',
                            data: datosTendencias,
                            backgroundColor: function (context) {
                                const index = context.dataIndex;
                                return index === 5 ? '#1e3a8a' : '#bfdbfe';
                            },
                            borderRadius: 6,
                            barPercentage: 0.6,
                            categoryPercentage: 0.8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#1e293b',
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: false,
                                callbacks: {
                                    label: function (context) {
                                        return context.parsed.y.toLocaleString() + ' pacientes';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 11 }, color: '#64748b' }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9', drawBorder: false },
                                ticks: {
                                    font: { size: 11 },
                                    color: '#64748b',
                                    callback: function (value) {
                                        return value.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Gráfico de Demografía (Donut)
            const ctxDemografia = document.getElementById('chartDemografia');
            if (ctxDemografia) {
                new Chart(ctxDemografia, {
                    type: 'doughnut',
                    data: {
                        labels: ['Adultos', 'Niños', 'Mayores'],
                        datasets: [{
                            data: [60, 25, 15],
                            backgroundColor: ['#1e3a8a', '#86efac', '#dbeafe'],
                            borderWidth: 0,
                            cutout: '75%'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}