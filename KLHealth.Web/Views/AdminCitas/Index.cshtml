@model KLHealth.Web.Models.ViewModels.AdminCitasViewModel
@{
    Layout = "_LayoutAdmin";
    var cultura = new System.Globalization.CultureInfo("es-ES");
    var nombreMes = Model.MesActual.ToString("MMMM yyyy", cultura).ToUpper();
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700); letter-spacing: -0.5px;">Agenda de Citas</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Admin")" class="text-decoration-none text-muted">Panel de Control</a></li>
                <li class="breadcrumb-item active" style="color: var(--blue-700); font-weight: 600;">Citas</li>
            </ol>
        </nav>
    </div>

    <div class="d-flex gap-3 align-items-center">
        <!-- Selector de Mes -->
        <div class="btn-group">
            <a href="@Url.Action("Index", "AdminCitas", new { mes = Model.MesActual.AddMonths(-1).Month, anio = Model.MesActual.AddMonths(-1).Year, medicoId = Model.MedicoFiltroId })"
               class="btn btn-outline-secondary" style="border-radius: 8px 0 0 8px;">
                <i class="bi bi-chevron-left"></i>
            </a>
            <button class="btn btn-outline-secondary" style="cursor: default; min-width: 150px;">
                @nombreMes
            </button>
            <a href="@Url.Action("Index", "AdminCitas", new { mes = Model.MesActual.AddMonths(1).Month, anio = Model.MesActual.AddMonths(1).Year, medicoId = Model.MedicoFiltroId })"
               class="btn btn-outline-secondary" style="border-radius: 0 8px 8px 0;">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        <!-- Filtro de Médico -->
        <form method="get" class="d-flex gap-2">
            <input type="hidden" name="mes" value="@Model.MesActual.Month" />
            <input type="hidden" name="anio" value="@Model.MesActual.Year" />
            <select name="medicoId" class="form-select form-select-sm" onchange="this.form.submit()" style="border-radius: 8px; min-width: 200px;">
                <option value="">Todos los Médicos</option>
                @foreach (var med in Model.MedicosDisponibles)
                {
                    <option value="@med.Id" selected="@(Model.MedicoFiltroId == med.Id)">@med.NombreCompleto</option>
                }
            </select>
        </form>

        <a href="#" class="btn btn-primary px-4 py-2" style="background: var(--blue-900); border-color: var(--blue-900); border-radius: 10px; font-weight: 500;">
            <i class="bi bi-plus-lg me-1"></i>Nueva Cita
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- COLUMNA IZQUIERDA: CALENDARIO -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px; overflow: hidden;">
            <div class="card-body p-0">
                <!-- Encabezado de días de la semana -->
                <div class="calendar-header d-grid" style="grid-template-columns: repeat(7, 1fr); background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                    <div class="p-3 text-center fw-bold small text-muted">LUN</div>
                    <div class="p-3 text-center fw-bold small text-muted">MAR</div>
                    <div class="p-3 text-center fw-bold small text-muted">MIÉ</div>
                    <div class="p-3 text-center fw-bold small text-muted">JUE</div>
                    <div class="p-3 text-center fw-bold small text-muted">VIE</div>
                    <div class="p-3 text-center fw-bold small text-muted">SÁB</div>
                    <div class="p-3 text-center fw-bold small text-muted">DOM</div>
                </div>

                <!-- Cuadrícula de días -->
                <div class="calendar-grid d-grid" style="grid-template-columns: repeat(7, 1fr); grid-auto-rows: minmax(120px, auto);">
                    @foreach (var day in Model.DiasDelMes)
                    {
                        <div class="calendar-day border-end border-bottom p-2 position-relative"
                             style="border-color: #f1f5f9 !important; background: @(day.EsMesActual ? "white" : "#f8fafc"); min-height: 120px;">

                            <!-- Número del día -->
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="small fw-bold @(day.EsHoy ? "text-white bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" : (day.EsMesActual ? "text-dark" : "text-muted"))"
                                      style="@(day.EsHoy ? "width: 24px; height: 24px; font-size: 0.75rem;" : "font-size: 0.85rem;")">
                                    @day.Fecha.Day
                                </span>
                            </div>

                            <!-- Citas del día -->
                            <div class="d-flex flex-column gap-1 overflow-auto" style="max-height: 90px;">
                                @foreach (var cita in day.Citas.Take(3)) // Mostrar máximo 3 para no romper el diseño
                                {
                                    <a href="@Url.Action("Detalles", "AdminCitas", new { id = cita.Id })"
                                       class="text-decoration-none d-block p-1 rounded small @cita.ColorBg @cita.ColorText"
                                       style="font-size: 0.7rem; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;"
                                       title="@cita.PacienteNombre - @cita.HoraFormateada">
                                        <span class="fw-bold">@cita.HoraFormateada</span> @cita.PacienteNombre.Split(' ').First()
                                    </a>
                                }
                                @if (day.Citas.Count > 3)
                                {
                                    <span class="small text-muted text-center" style="font-size: 0.65rem;">+@(day.Citas.Count - 3) más</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- COLUMNA DERECHA: PANEL LATERAL -->
    <div class="col-lg-4">
        <!-- Resumen de Citas -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="font-size: 1rem; color: #0f172a;">
                    Resumen de Citas <span class="badge bg-primary bg-opacity-10 text-primary ms-2" style="font-size: 0.7rem;">TIEMPO REAL</span>
                </h5>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded" style="background: #f8fafc;">
                            <div class="small text-muted mb-1">Total Hoy</div>
                            <div class="fw-bold fs-4" style="color: var(--blue-700);">@Model.TotalCitasHoy</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background: #f8fafc;">
                            <div class="small text-muted mb-1">Confirmadas</div>
                            <div class="fw-bold fs-4 text-success">@Model.TotalConfirmadasHoy</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cronograma de Hoy -->
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0" style="font-size: 1rem; color: #0f172a;">Cronograma de Hoy</h5>
                    <a href="#" class="small text-decoration-none" style="color: var(--blue-700); font-weight: 600;">Ver Lista</a>
                </div>

                @if (Model.CronogramaHoy.Any())
                {
                    <div class="timeline-custom">
                        @foreach (var cita in Model.CronogramaHoy)
                        {
                            string badgeClass = cita.Estado switch
                            {
                                "Confirmada" => "bg-success bg-opacity-10 text-success",
                                "Pendiente" => "bg-warning bg-opacity-10 text-warning",
                                "Cancelada" => "bg-danger bg-opacity-10 text-danger",
                                "Completada" => "bg-secondary bg-opacity-10 text-secondary",
                                _ => "bg-primary bg-opacity-10 text-primary"
                            };

                            <div class="d-flex gap-3 mb-4 position-relative">
                                <!-- Línea de tiempo -->
                                <div class="d-flex flex-column align-items-center">
                                    <div class="rounded-circle" style="width: 12px; height: 12px; background: var(--blue-700); flex-shrink: 0;"></div>
                                    @if (cita != Model.CronogramaHoy.Last())
                                    {
                                        <div style="width: 2px; flex-grow: 1; background: #e2e8f0; margin-top: 4px;"></div>
                                    }
                                </div>

                                <!-- Contenido de la cita -->
                                <div class="flex-grow-1 pb-2">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold mb-0" style="font-size: 0.95rem; color: #0f172a;">@cita.PacienteNombre</h6>
                                        <span class="badge rounded-pill px-2 py-1 @badgeClass" style="font-size: 0.65rem; font-weight: 700;">@cita.Estado.ToUpper()</span>
                                    </div>
                                    <div class="small text-muted mb-2">Consulta General</div>

                                    <div class="d-flex gap-3 small text-muted">
                                        <span><i class="bi bi-clock me-1"></i>@cita.HoraFormateada</span>
                                        <span><i class="bi bi-door-open me-1"></i>@cita.Sala</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-calendar-x" style="font-size: 2rem; color: #cbd5e1;"></i>
                        <p class="text-muted small mt-2 mb-0">No hay citas programadas para hoy.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Estilos específicos para el calendario */
        .calendar-day:hover {
            background-color: #f8fafc !important;
            transition: background-color 0.2s ease;
        }

        .calendar-grid::-webkit-scrollbar {
            width: 6px;
        }

        .calendar-grid::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 4px;
        }

        .timeline-custom {
            max-height: 400px;
            overflow-y: auto;
            padding-right: 10px;
        }
    </style>
}