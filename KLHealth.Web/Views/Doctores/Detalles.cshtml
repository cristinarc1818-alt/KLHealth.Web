@model KLHealth.Web.Models.ViewModels.DoctorDetallesViewModel
@{
    Layout = "_LayoutPaciente";
    ViewData["Title"] = $"{Model.Titulo} {Model.NombreCompleto}";
}

<!-- Breadcrumb y Volver -->
<div class="mb-4">
    <a href="@Url.Action("Index", "Doctores")" class="btn btn-outline-secondary" style="border-radius: 8px;">
        <i class="bi bi-arrow-left me-2"></i>Volver a Doctores
    </a>
</div>

<!-- HERO - Cabecera del Perfil -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: hidden;">
    <div class="card-body p-0">
        <div class="row g-0">
            <!-- Columna Izquierda - Foto -->
            <div class="col-md-4" style="background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%); padding: 2rem;">
                <div class="text-center">
                    <img src="@Model.FotoPerfilUrl" alt="@Model.NombreFormateado"
                         class="rounded-circle shadow"
                         style="width: 180px; height: 180px; object-fit: cover; border: 5px solid white;">

                    <div class="mt-3">
                        @if (Model.EstaDisponible)
                        {
                            <span class="badge bg-success px-3 py-2" style="border-radius: 20px;">
                                <i class="bi bi-check-circle me-1"></i>Disponible
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2" style="border-radius: 20px;">
                                <i class="bi bi-clock me-1"></i>No disponible
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Columna Derecha - Información Principal -->
            <div class="col-md-8 p-4 p-md-5">
                <div class="mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2"
                          style="border-radius: 20px; font-size: 0.8rem; color: #1e3a8a !important;">
                        @Model.Especialidad
                    </span>
                </div>

                <h1 class="fw-bold mb-2" style="color: #0f172a; font-size: 1.9rem; letter-spacing: -0.5px;">
                    @Model.NombreFormateado
                </h1>

                <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-star-fill" style="color: #fbbf24;"></i>
                        <span class="fw-bold">@Model.Calificacion.ToString("0.0")</span>
                        <small class="text-muted">(@Model.TotalResenas reseñas)</small>
                    </div>
                    <span class="text-muted">•</span>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-award-fill" style="color: #1e3a8a;"></i>
                        <small class="fw-semibold">@Model.Experiencia de experiencia</small>
                    </div>
                    <span class="text-muted">•</span>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-card-checklist" style="color: #1e3a8a;"></i>
                        <small class="fw-semibold">Lic. @Model.NumeroLicencia</small>
                    </div>
                </div>

                <p class="text-muted mb-4" style="font-size: 0.95rem; line-height: 1.7;">
                    @(Model.Biografia ?? "Profesional de la salud comprometido con brindar atención de calidad y un trato humano a cada uno de sus pacientes.")
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    @if (Model.EstaDisponible)
                    {
                        <a href="@Url.Action("Agendar", "Citas", new { medicoId = Model.Id })"
                           class="btn btn-primary px-4 py-2"
                           style="background: #1e3a8a; border-color: #1e3a8a; border-radius: 10px; font-weight: 600;">
                            <i class="bi bi-calendar-plus me-2"></i>Agendar Cita
                        </a>
                    }
                    <a href="@Url.Action("Index", "Citas")" class="btn btn-outline-secondary px-4 py-2"
                       style="border-radius: 10px;">
                        <i class="bi bi-chat-dots me-2"></i>Consultar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Información Detallada -->
<div class="row g-4">
    <!-- Columna Principal -->
    <div class="col-lg-8">

        <!-- Sobre Mí -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="color: #0f172a;">
                    <i class="bi bi-person-badge me-2" style="color: #1e3a8a;"></i>Sobre mí
                </h5>
                <p class="text-muted mb-0" style="line-height: 1.8; font-size: 0.95rem;">
                    @(Model.Biografia ?? $"Soy {Model.NombreFormateado}, especialista en {Model.Especialidad}. Mi enfoque se centra en brindar una atención integral, combinando los últimos avances médicos con un trato cercano y personalizado.")
                </p>
            </div>
        </div>

        <!-- Formación Académica -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4" style="color: #0f172a;">
                    <i class="bi bi-mortarboard-fill me-2" style="color: #1e3a8a;"></i>Formación Académica
                </h5>

                <div class="timeline">
                    @foreach (var formacion in Model.FormacionAcademica)
                    {
                        <div class="timeline-item">
                            <div class="timeline-icon">
                                <i class="bi @formacion.Icono"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold mb-1" style="color: #0f172a;">@formacion.Titulo</h6>
                                <p class="text-muted mb-1 small">@formacion.Institucion</p>
                                <small class="text-primary" style="color: #1e3a8a !important;">@formacion.Periodo</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Servicios -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="color: #0f172a;">
                    <i class="bi bi-list-check me-2" style="color: #1e3a8a;"></i>Servicios
                </h5>
                <div class="row g-2">
                    @foreach (var servicio in Model.Servicios)
                    {
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2 p-2"
                                 style="background: #f8fafc; border-radius: 8px;">
                                <i class="bi bi-check-circle-fill" style="color: #16a34a;"></i>
                                <span style="font-size: 0.9rem;">@servicio</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Reseñas -->
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0" style="color: #0f172a;">
                        <i class="bi bi-star-fill me-2" style="color: #fbbf24;"></i>Reseñas de Pacientes
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 px-3 py-2" style="color: #1e3a8a !important;">
                        @Model.Calificacion.ToString("0.0")/5.0
                    </span>
                </div>

                @foreach (var resena in Model.Resenas)
                {
                    <div class="review-item pb-3 mb-3" style="border-bottom: 1px solid #f1f5f9;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px; background: #dbeafe; color: #1e3a8a; font-weight: 600;">
                                    @resena.NombrePaciente[0]
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.95rem;">@resena.NombrePaciente</h6>
                                    <small class="text-muted">@resena.FechaRelativa</small>
                                </div>
                            </div>
                            <div>
                                @for (int i = 0; i < resena.Rating; i++)
                                {
                                    <i class="bi bi-star-fill" style="color: #fbbf24; font-size: 0.9rem;"></i>
                                }
                            </div>
                        </div>
                        <p class="text-muted mb-0" style="font-size: 0.9rem; line-height: 1.6; padding-left: 52px;">
                            @resena.Comentario
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Columna Lateral -->
    <div class="col-lg-4">

        <!-- Tarjeta de Agendar -->
        @if (Model.EstaDisponible)
        {
            <div class="card border-0 shadow-sm mb-4 position-sticky" style="top: 20px; border-radius: 14px; background: #1e3a8a; color: white;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3" style="font-size: 1rem;">
                        <i class="bi bi-calendar-check me-2"></i>¿Listo para tu consulta?
                    </h5>
                    <p class="mb-4" style="font-size: 0.88rem; opacity: 0.9;">
                        Agenda tu cita con @Model.NombreFormateado en solo unos minutos.
                    </p>
                    <a href="@Url.Action("Agendar", "Citas", new { medicoId = Model.Id })"
                       class="btn btn-light w-100 py-2 fw-semibold"
                       style="border-radius: 10px; color: #1e3a8a;">
                        <i class="bi bi-calendar-plus me-2"></i>Agendar Ahora
                    </a>
                </div>
            </div>
        }

        <!-- Horarios -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="color: #0f172a;">
                    <i class="bi bi-clock-history me-2" style="color: #1e3a8a;"></i>Horarios de Atención
                </h6>
                <div class="d-flex flex-column gap-2">
                    @foreach (var h in Model.Horarios)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2"
                             style="background: #f8fafc; border-radius: 8px; font-size: 0.88rem;">
                            <span class="fw-semibold">@h.Dia</span>
                            <span class="text-muted">@h.Hora</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Información de Contacto -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="color: #0f172a;">
                    <i class="bi bi-info-circle me-2" style="color: #1e3a8a;"></i>Información
                </h6>
                <ul class="list-unstyled mb-0" style="font-size: 0.9rem;">
                    <li class="mb-2">
                        <i class="bi bi-card-checklist me-2 text-primary" style="color: #1e3a8a !important;"></i>
                        <strong>Licencia:</strong> @Model.NumeroLicencia
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-translate me-2 text-primary" style="color: #1e3a8a !important;"></i>
                        <strong>Idiomas:</strong> @string.Join(", ", Model.Idiomas)
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-hospital me-2 text-primary" style="color: #1e3a8a !important;"></i>
                        <strong>Clínica:</strong> KL Health Central
                    </li>
                    <li>
                        <i class="bi bi-camera-video me-2 text-primary" style="color: #1e3a8a !important;"></i>
                        <strong>Teleconsulta:</strong> Disponible
                    </li>
                </ul>
            </div>
        </div>

        <!-- Política de Cancelación -->
        <div class="card border-0" style="background: #eff6ff; border-radius: 12px; border-left: 4px solid #1e3a8a;">
            <div class="card-body p-3">
                <div class="d-flex gap-2">
                    <i class="bi bi-info-circle-fill" style="color: #1e3a8a; font-size: 1.2rem;"></i>
                    <div>
                        <h6 class="fw-bold mb-1" style="font-size: 0.85rem; color: #1e3a8a;">Política de Cancelación</h6>
                        <p class="mb-0 small text-muted" style="font-size: 0.8rem; line-height: 1.5;">
                            Puedes cancelar o reprogramar tu cita hasta 24 horas antes sin costo.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Timeline */
        .timeline {
            position: relative;
            padding-left: 0;
        }

        .timeline-item {
            display: flex;
            gap: 1rem;
            position: relative;
            padding-bottom: 1.5rem;
        }

            .timeline-item:not(:last-child)::before {
                content: '';
                position: absolute;
                left: 19px;
                top: 40px;
                bottom: 0;
                width: 2px;
                background: #e2e8f0;
            }

        .timeline-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #dbeafe;
            color: #1e3a8a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .timeline-content {
            flex: 1;
        }

        .review-item:last-child {
            border-bottom: none !important;
            padding-bottom: 0 !important;
            margin-bottom: 0 !important;
        }
    </style>
}