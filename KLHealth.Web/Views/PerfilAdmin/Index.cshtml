@model KLHealth.Web.Models.ViewModels.PerfilAdminViewModel
@{
    Layout = "_LayoutAdmin";
    var cultura = new System.Globalization.CultureInfo("es-ES");
}

<div class="mb-4">
    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700);">Mi Perfil</h1>
    <p class="text-muted mb-0">Gestiona tu información personal y configuración de cuenta.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4" style="border-radius: 10px;">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="row g-4">
    <!-- Columna Izquierda: Tarjeta de Perfil -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm text-center" style="border-radius: 14px; overflow: hidden;">
            <div class="card-body p-4">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.FotoPerfilUrl))
                    {
                        <img src="@Model.FotoPerfilUrl" alt="Foto" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #dbeafe;">
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto"
                             style="width: 120px; height: 120px; background: #dbeafe; color: var(--blue-700); font-size: 3rem; font-weight: bold;">
                            @Model.NombreCompleto.Split(' ').Select(n => n[0]).Take(2).Aggregate("", (a, c) => a + c)
                        </div>
                    }
                </div>

                <h4 class="fw-bold mb-1" style="color: #0f172a;">@Model.NombreCompleto</h4>
                <p class="text-muted small mb-3">@Model.Rol</p>

                @if (!string.IsNullOrEmpty(Model.Especialidad))
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 mb-3" style="border-radius: 20px;">
                        <i class="bi bi-heart-pulse me-1"></i>@Model.Especialidad
                    </span>
                }

                <div class="d-grid gap-2 mt-4">
                    <a href="@Url.Action("Editar", "PerfilAdmin")" class="btn btn-primary" style="background: var(--blue-900); border-radius: 8px;">
                        <i class="bi bi-pencil me-2"></i>Editar Información
                    </a>
                    <button class="btn btn-outline-secondary" style="border-radius: 8px;">
                        <i class="bi bi-key me-2"></i>Cambiar Contraseña
                    </button>
                </div>
            </div>
        </div>

        <!-- Estado de Cuenta -->
        <div class="card border-0 shadow-sm mt-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="color: #0f172a;">Estado de la Cuenta</h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(Model.EstaActivo ? "bg-success" : "bg-danger")" style="font-size: 0.8rem; padding: 0.5rem 1rem;">
                        @(Model.EstaActivo ? "Activo" : "Inactivo")
                    </span>
                    <small class="text-muted">
                        <i class="bi bi-calendar-check me-1"></i>Creada el @Model.FechaRegistro.ToString("dd MMM yyyy", cultura)
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Detalles -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-header border-0 py-3 px-4" style="background: #f8fafc;">
                <h5 class="fw-bold mb-0" style="color: #0f172a;">Información de Contacto</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="small text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Nombre Completo</label>
                        <p class="fw-semibold mb-0 mt-1" style="color: #0f172a;">@Model.NombreCompleto</p>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Correo Electrónico</label>
                        <p class="fw-semibold mb-0 mt-1" style="color: #0f172a;">@Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Teléfono</label>
                        <p class="fw-semibold mb-0 mt-1" style="color: #0f172a;">@(string.IsNullOrEmpty(Model.Telefono) ? "No registrado" : Model.Telefono)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Rol en el Sistema</label>
                        <p class="fw-semibold mb-0 mt-1" style="color: #0f172a;">@Model.Rol</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>