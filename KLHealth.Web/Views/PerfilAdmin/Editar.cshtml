@model KLHealth.Web.Models.ViewModels.PerfilAdminViewModel
@{
    Layout = "_LayoutAdmin";
}

<div class="mb-4">
    <a href="@Url.Action("Index", "PerfilAdmin")" class="btn btn-outline-secondary mb-3" style="border-radius: 8px;">
        <i class="bi bi-arrow-left me-2"></i>Volver al Perfil
    </a>
    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700);">Editar Perfil</h1>
    <p class="text-muted mb-0">Actualiza tu información personal de contacto.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <form asp-action="Editar" asp-controller="PerfilAdmin" method="post">
                    @Html.AntiForgeryToken()

                    <!-- ID oculto necesario para el POST -->
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="form-control" style="border-radius: 8px;" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control" disabled style="background: #f8fafc; border-radius: 8px; cursor: not-allowed;" />
                        <small class="text-muted">El correo electrónico no se puede cambiar desde aquí por seguridad.</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TelefonoEdit" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="TelefonoEdit" class="form-control" placeholder="Ej: +1 234 567 8900" style="border-radius: 8px;" />
                        <span asp-validation-for="TelefonoEdit" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-3 pt-2">
                        <button type="submit" class="btn btn-primary px-4 py-2" style="background: var(--blue-900); border-color: var(--blue-900); border-radius: 10px; font-weight: 600;">
                            <i class="bi bi-check-circle me-2"></i>Guardar Cambios
                        </button>
                        <a href="@Url.Action("Index", "PerfilAdmin")" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}