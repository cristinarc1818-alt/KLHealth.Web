
@model KLHealth.Web.Models.Entities.Medico
@{
    Layout = "_LayoutAdmin";

    var totalCitas = ViewBag.TotalCitas as int? ?? 0;
    var citasCompletadas = ViewBag.CitasCompletadas as int? ?? 0;

    // ============================================================
    // NORMALIZAR NOMBRE DEL MÉDICO
    // ============================================================

    string nombreMedico = Model.Usuario?.NombreCompleto?.Trim() ?? "";
    string tituloMedico = Model.Titulo?.Trim() ?? "";

    // Eliminar títulos que puedan estar guardados dentro de NombreCompleto
    while (
        nombreMedico.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ||
        nombreMedico.StartsWith("Dra.", StringComparison.OrdinalIgnoreCase) ||
        nombreMedico.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase) ||
        nombreMedico.StartsWith("Dra ", StringComparison.OrdinalIgnoreCase) ||
        nombreMedico.StartsWith("Doctor ", StringComparison.OrdinalIgnoreCase) ||
        nombreMedico.StartsWith("Doctora ", StringComparison.OrdinalIgnoreCase)
    )
    {
        if (nombreMedico.StartsWith("Dra.", StringComparison.OrdinalIgnoreCase))
        {
            nombreMedico = nombreMedico.Substring(4).Trim();
        }
        else if (nombreMedico.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
        {
            nombreMedico = nombreMedico.Substring(3).Trim();
        }
        else if (nombreMedico.StartsWith("Dra ", StringComparison.OrdinalIgnoreCase))
        {
            nombreMedico = nombreMedico.Substring(4).Trim();
        }
        else if (nombreMedico.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase))
        {
            nombreMedico = nombreMedico.Substring(3).Trim();
        }
        else if (nombreMedico.StartsWith("Doctora ", StringComparison.OrdinalIgnoreCase))
        {
            nombreMedico = nombreMedico.Substring(8).Trim();
        }
        else if (nombreMedico.StartsWith("Doctor ", StringComparison.OrdinalIgnoreCase))
        {
            nombreMedico = nombreMedico.Substring(7).Trim();
        }
    }

    // ============================================================
    // NORMALIZAR TÍTULO
    // ============================================================

    if (tituloMedico.Contains("Dra", StringComparison.OrdinalIgnoreCase) ||
        tituloMedico.Contains("Doctora", StringComparison.OrdinalIgnoreCase))
    {
        tituloMedico = "Dra.";
    }
    else if (tituloMedico.Contains("Dr", StringComparison.OrdinalIgnoreCase) ||
             tituloMedico.Contains("Doctor", StringComparison.OrdinalIgnoreCase))
    {
        tituloMedico = "Dr.";
    }
    else
    {
        tituloMedico = "";
    }

    // Nombre completo final para mostrar
    string nombreCompletoMostrar = string.IsNullOrEmpty(tituloMedico)
        ? nombreMedico
        : $"{tituloMedico} {nombreMedico}";
}


<!-- ============================================================
     HEADER
     ============================================================ -->

<div class="mb-4">

    <a href="@Url.Action("Index", "AdminMedicos")"
       class="btn btn-outline-secondary mb-3"
       style="border-radius: 8px; border-color: #e2e8f0;">

        <i class="bi bi-arrow-left me-2"></i>
        Volver a la lista

    </a>


    <div class="d-flex justify-content-between align-items-start">

        <div>

            <h1 class="fw-bold mb-1"
                style="font-size: 2rem; color: #0f172a; letter-spacing: -0.5px;">

                @nombreCompletoMostrar

            </h1>

            <p class="text-muted mb-0"
               style="font-size: 0.95rem;">

                @(Model.Especialidad?.Nombre ?? "Medicina General")

            </p>

        </div>


        <div class="d-flex gap-2">

            @if (Model.EstaDisponible)
            {
                <span class="badge rounded-pill px-3 py-2 bg-success bg-opacity-10 text-success"
                      style="font-size: 0.85rem; font-weight: 600;">

                    <i class="bi bi-check-circle me-1"></i>
                    Disponible

                </span>
            }
            else
            {
                <span class="badge rounded-pill px-3 py-2 bg-danger bg-opacity-10 text-danger"
                      style="font-size: 0.85rem; font-weight: 600;">

                    <i class="bi bi-x-circle me-1"></i>
                    No Disponible

                </span>
            }


            @if (Model.EstaDeGuardia)
            {
                <span class="badge rounded-pill px-3 py-2 bg-primary bg-opacity-10 text-primary"
                      style="font-size: 0.85rem; font-weight: 600;">

                    <i class="bi bi-shield-check me-1"></i>
                    De Guardia

                </span>
            }

        </div>

    </div>

</div>


<!-- ============================================================
     CONTENIDO PRINCIPAL
     ============================================================ -->

<div class="row g-4">


    <!-- ============================================================
         COLUMNA IZQUIERDA
         ============================================================ -->

    <div class="col-lg-4">


        <!-- FOTO DE PERFIL -->

        <div class="card border-0 shadow-sm mb-4"
             style="border-radius: 14px;">

            <div class="card-body p-4 text-center">

                <img src="@(Model.FotoPerfilUrl ?? "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=200&h=200&fit=crop&crop=face")"
                     alt="@nombreMedico"
                     class="rounded-circle mb-3"
                     style="width: 150px; height: 150px; object-fit: cover; border: 5px solid #dbeafe; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);">


                <h4 class="fw-bold mb-1"
                    style="color: #0f172a;">

                    @nombreCompletoMostrar

                </h4>


                <p class="text-muted mb-2">

                    @Model.Especialidad?.Nombre

                </p>


                <span class="badge bg-light text-dark px-3 py-2 rounded-pill"
                      style="font-size: 0.8rem;">

                    <i class="bi bi-patch-check me-1"></i>

                    @Model.NumeroLicencia

                </span>


                <div class="d-grid gap-2 mt-4">

                    <a href="@Url.Action("Editar", "AdminMedicos", new { id = Model.Id })"
                       class="btn btn-primary px-4 py-2"
                       style="background: var(--blue-900); border-color: var(--blue-900); border-radius: 10px; font-weight: 600;">

                        <i class="bi bi-pencil me-2"></i>
                        Editar Perfil

                    </a>

                </div>

            </div>

        </div>


        <!-- ========================================================
             ESTADÍSTICAS
             ======================================================== -->

        <div class="card border-0 shadow-sm"
             style="border-radius: 14px;">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-4"
                    style="color: #0f172a; font-size: 1rem;">

                    <i class="bi bi-bar-chart me-2"
                       style="color: var(--blue-700);"></i>

                    Estadísticas

                </h5>


                <div class="d-flex justify-content-between align-items-center mb-3 pb-3"
                     style="border-bottom: 1px solid #e2e8f0;">

                    <div>
                        <div class="text-muted small">
                            Total de Citas
                        </div>
                    </div>

                    <div class="fw-bold"
                         style="color: var(--blue-700); font-size: 1.5rem;">

                        @totalCitas

                    </div>

                </div>


                <div class="d-flex justify-content-between align-items-center mb-3 pb-3"
                     style="border-bottom: 1px solid #e2e8f0;">

                    <div>
                        <div class="text-muted small">
                            Citas Completadas
                        </div>
                    </div>

                    <div class="fw-bold text-success"
                         style="font-size: 1.5rem;">

                        @citasCompletadas

                    </div>

                </div>


                <div class="d-flex justify-content-between align-items-center mb-3 pb-3"
                     style="border-bottom: 1px solid #e2e8f0;">

                    <div>
                        <div class="text-muted small">
                            Tasa de Completitud
                        </div>
                    </div>

                    <div class="fw-bold"
                         style="color: var(--blue-700); font-size: 1.2rem;">

                        @(totalCitas > 0
                            ? ((citasCompletadas * 100.0 / totalCitas).ToString("0.0") + "%")
                            : "0%")

                    </div>

                </div>


                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Años de Experiencia
                        </div>
                    </div>

                    <div class="fw-bold"
                         style="color: var(--blue-700); font-size: 1.2rem;">

                        @Model.AniosExperiencia

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         COLUMNA DERECHA
         ============================================================ -->

    <div class="col-lg-8">


        <!-- ========================================================
             INFORMACIÓN DE CONTACTO
             ======================================================== -->

        <div class="card border-0 shadow-sm mb-4"
             style="border-radius: 14px;">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-4"
                    style="color: #0f172a; font-size: 1rem;">

                    <i class="bi bi-person-badge me-2"
                       style="color: var(--blue-700);"></i>

                    Información de Contacto

                </h5>


                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Correo Electrónico
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @Model.Usuario.Email

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Teléfono
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @(Model.Usuario.Telefono ?? "No registrado")

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Número de Licencia
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @Model.NumeroLicencia

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Título Profesional
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @Model.Titulo

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             INFORMACIÓN PROFESIONAL
             ======================================================== -->

        <div class="card border-0 shadow-sm mb-4"
             style="border-radius: 14px;">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-4"
                    style="color: #0f172a; font-size: 1rem;">

                    <i class="bi bi-briefcase-medical me-2"
                       style="color: var(--blue-700);"></i>

                    Información Profesional

                </h5>


                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Especialidad
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @(Model.Especialidad?.Nombre ?? "General")

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Años de Experiencia
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @Model.AniosExperiencia años

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Costo de Consulta
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @if (Model.CostoConsulta.HasValue)
                            {
                                <span>
                                    $@Model.CostoConsulta.Value.ToString("0.00")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No especificado
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="small text-muted mb-1">
                            Calificación Promedio
                        </div>

                        <div class="fw-semibold"
                             style="color: #0f172a;">

                            @if (Model.CalificacionPromedio.HasValue &&
                                 Model.CalificacionPromedio > 0)
                            {
                                <span>

                                    @Model.CalificacionPromedio.Value.ToString("0.0")

                                    <i class="bi bi-star-fill text-warning"></i>

                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sin calificaciones
                                </span>
                            }

                        </div>

                    </div>

                </div>


                @if (!string.IsNullOrEmpty(Model.Biografia))
                {
                    <div class="mt-4 pt-4"
                         style="border-top: 1px solid #e2e8f0;">

                        <div class="small text-muted mb-2">
                            Biografía / Perfil Profesional
                        </div>

                        <p class="text-muted mb-0"
                           style="line-height: 1.6;">

                            @Model.Biografia

                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- ========================================================
             CONFIGURACIÓN DE ESTADO
             ======================================================== -->

        <div class="card border-0 shadow-sm"
             style="border-radius: 14px;">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-4"
                    style="color: #0f172a; font-size: 1rem;">

                    <i class="bi bi-toggles me-2"
                       style="color: var(--blue-700);"></i>

                    Configuración de Estado

                </h5>


                <div class="row g-3">


                    <!-- ESTADO DE GUARDIA -->

                    <div class="col-md-6">

                        <div class="p-3 rounded"
                             style="
                            background: @(Model.EstaDeGuardia ? "#dcfce7" : "#f8fafc");
                            border: 1px solid @(Model.EstaDeGuardia ? "#86efac" : "#e2e8f0");
                            ">

                            <div class="d-flex align-items-center gap-2">

                                <i class="bi bi-shield-check"
                                   style="
                                color: @(Model.EstaDeGuardia ? "#166534" : "#64748b");
                                font-size: 1.5rem;
                                "></i>

                                <div>

                                    <div class="fw-semibold"
                                         style="
                                        color: @(Model.EstaDeGuardia ? "#166534" : "#64748b");
                                        ">

                                        Estado de Guardia

                                    </div>

                                    <div class="small"
                                         style="
                                        color: @(Model.EstaDeGuardia ? "#166534" : "#64748b");
                                        ">

                                        @(Model.EstaDeGuardia ? "Activo" : "Inactivo")

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- DISPONIBILIDAD -->

                    <div class="col-md-6">

                        <div class="p-3 rounded"
                             style="
                            background: @(Model.EstaDisponible ? "#dcfce7" : "#fef2f2");
                            border: 1px solid @(Model.EstaDisponible ? "#86efac" : "#fecaca");
                            ">

                            <div class="d-flex align-items-center gap-2">

                                <i class="bi bi-calendar-check"
                                   style="
                                color: @(Model.EstaDisponible ? "#166534" : "#dc2626");
                                font-size: 1.5rem;
                                "></i>

                                <div>

                                    <div class="fw-semibold"
                                         style="
                                        color: @(Model.EstaDisponible ? "#166534" : "#dc2626");
                                        ">

                                        Disponible para Citas

                                    </div>

                                    <div class="small"
                                         style="
                                        color: @(Model.EstaDisponible ? "#166534" : "#dc2626");
                                        ">

                                        @(Model.EstaDisponible ? "Activo" : "Inactivo")

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
```
