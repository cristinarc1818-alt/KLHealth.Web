@model KLHealth.Web.Models.ViewModels.CrearResultadoViewModel
@{
    Layout = "_LayoutAdmin";
    var tieneErrores = !ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0;

    // Fecha por defecto: hoy
    var fechaPorDefecto = Model.Fecha == default ? DateTime.Now.ToString("yyyy-MM-dd") : Model.Fecha.ToString("yyyy-MM-dd");
}

<div class="mb-4">
    <a href="@Url.Action("Index", "ResultadosAdmin")" class="btn btn-outline-secondary mb-3" style="border-radius: 8px;">
        <i class="bi bi-arrow-left me-2"></i>Volver a Resultados
    </a>

    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700);">Nuevo Resultado Médico</h1>
    <p class="text-muted mb-0">Registre un nuevo resultado de examen o estudio médico.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <form asp-action="Crear" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @* Solo mostrar el resumen si hay errores *@
                    @if (tieneErrores)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-start gap-2 mb-4" style="border-radius: 10px; font-size: 0.9rem;">
                            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                            <div>
                                <strong>Por favor corrija los siguientes errores:</strong>
                            </div>
                        </div>
                    }

                    <!-- Datos del Paciente y Médico -->
                    <h5 class="fw-bold mb-3" style="color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
                        <i class="bi bi-people-fill me-2" style="color: var(--blue-700);"></i>Información General
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PacienteId" class="form-label fw-semibold">
                                Paciente <span class="text-danger">*</span>
                            </label>
                            <select asp-for="PacienteId" class="form-select" style="border-radius: 8px;" required>
                                <option value="">-- Seleccione un paciente --</option>
                                @foreach (var p in Model.Pacientes)
                                {
                                    var selected = p.Id == Model.PacienteId ? "selected" : "";
                                    <option value="@p.Id" selected="@selected">@p.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="PacienteId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MedicoId" class="form-label fw-semibold">
                                Médico Responsable <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MedicoId" class="form-select" style="border-radius: 8px;" required>
                                <option value="">-- Seleccione un médico --</option>
                                @foreach (var m in Model.Medicos)
                                {
                                    var selected = m.Id == Model.MedicoId ? "selected" : "";
                                    <option value="@m.Id" selected="@selected">@m.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="MedicoId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Tipo y Nombre del Examen -->
                    <h5 class="fw-bold mb-3" style="color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
                        <i class="bi bi-file-earmark-medical me-2" style="color: var(--blue-700);"></i>Detalles del Examen
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Tipo" class="form-label fw-semibold">
                                Tipo de Estudio <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Tipo" class="form-select" style="border-radius: 8px;" required>
                                <option value="">-- Seleccione un tipo --</option>
                                @foreach (var t in Model.TiposExamen)
                                {
                                    var selected = t.Nombre == Model.Tipo ? "selected" : "";
                                    <option value="@t.Nombre" selected="@selected">@t.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="Tipo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label fw-semibold">
                                Fecha del Resultado <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Fecha" type="date" class="form-control"
                                   value="@fechaPorDefecto"
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   style="border-radius: 8px;" required>
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="NombreExamen" class="form-label fw-semibold">
                                Nombre del Examen <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NombreExamen" class="form-control"
                                   placeholder="Ej: Hemograma Completo, Radiografía de Tórax..."
                                   style="border-radius: 8px;" required>
                            <span asp-validation-for="NombreExamen" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label fw-semibold">
                                Hallazgos / Descripción <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Descripcion" class="form-control" rows="7"
                                      placeholder="Describa detalladamente los hallazgos del examen..."
                                      style="border-radius: 8px;" required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ArchivoUrl" class="form-label fw-semibold">
                                URL del Archivo (opcional)
                            </label>
                            <input asp-for="ArchivoUrl" class="form-control"
                                   placeholder="https://..."
                                   style="border-radius: 8px;">
                            <span asp-validation-for="ArchivoUrl" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Si el resultado tiene un archivo adjunto (PDF, imagen), ingrese la URL aquí.
                            </div>
                        </div>
                    </div>

                    <!-- Estado Inicial -->
                    <h5 class="fw-bold mb-3" style="color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
                        <i class="bi bi-flag-fill me-2" style="color: var(--blue-700);"></i>Estado
                    </h5>

                    <div class="mb-4 p-3" style="background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkFinalizado"
                                   style="cursor: pointer;" onchange="document.getElementById('lblEstado').textContent = this.checked ? 'Finalizado' : 'Pendiente'">
                            <label class="form-check-label" for="chkFinalizado" style="cursor: pointer;">
                                Marcar resultado como <strong id="lblEstado">Pendiente</strong> desde el inicio
                            </label>
                            <div class="form-text mt-1">
                                Actívelo si el estudio ya fue revisado por el médico y no requiere aprobación posterior.
                            </div>
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="d-flex gap-3 mt-4 pt-3" style="border-top: 1px solid #e2e8f0;">
                        <button type="submit" class="btn btn-primary px-4 py-2"
                                style="background: var(--blue-900); border-color: var(--blue-900); border-radius: 10px; font-weight: 600;">
                            <i class="bi bi-check-circle me-2"></i>Guardar Resultado
                        </button>
                        <a href="@Url.Action("Index", "ResultadosAdmin")" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Panel de ayuda -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px; background: #eff6ff; border-left: 4px solid var(--blue-900);">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="color: var(--blue-900);">
                    <i class="bi bi-info-circle me-1"></i>Información
                </h6>
                <ul class="mb-0 small ps-3" style="color: #475569; line-height: 1.8;">
                    <li>Los resultados se guardarán con estado <strong>Pendiente</strong> por defecto.</li>
                    <li>Podrá cambiarlos a <strong>Finalizado</strong> desde la lista de resultados.</li>
                    <li>El paciente recibirá una notificación al finalizar el estudio.</li>
                </ul>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px; background: #f0fdf4; border-left: 4px solid #16a34a;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="color: #166534;">
                    <i class="bi bi-lightbulb me-1"></i>Consejos
                </h6>
                <ul class="mb-0 small ps-3" style="color: #475569; line-height: 1.8;">
                    <li>Sea detallado en la descripción de los <strong>hallazgos</strong>.</li>
                    <li>Incluya valores de referencia cuando aplique.</li>
                    <li>Adjunte un archivo PDF si el estudio es complejo.</li>
                </ul>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #fef3c7; border-left: 4px solid #f59e0b;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-2" style="color: #92400e;">
                    <i class="bi bi-exclamation-triangle me-1"></i>Recuerde
                </h6>
                <p class="mb-0 small" style="color: #475569; line-height: 1.6;">
                    Los resultados <strong>finalizados</strong> no pueden ser modificados por seguridad clínica. Verifique todos los datos antes de guardar.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Validación en tiempo real: quitar borde rojo cuando el usuario corrige
        document.querySelectorAll('.form-control, .form-select').forEach(el => {
            el.addEventListener('input', function() {
                if (this.checkValidity()) {
                    this.classList.remove('is-invalid');
                }
            });
            el.addEventListener('change', function() {
                if (this.checkValidity()) {
                    this.classList.remove('is-invalid');
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        /* Estilo de campos inválidos consistente con Bootstrap */
        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
            padding-right: calc(1.5em + 0.75rem);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--blue-700);
            box-shadow: 0 0 0 0.25rem rgba(30, 58, 138, 0.15);
        }

        /* Checkbox personalizado */
        .form-check-input:checked {
            background-color: var(--blue-900);
            border-color: var(--blue-900);
        }

        .form-check-input:focus {
            border-color: var(--blue-700);
            box-shadow: 0 0 0 0.25rem rgba(30, 58, 138, 0.15);
        }
    </style>
}