@model KLHealth.Web.Models.ViewModels.NotificacionesViewModel
@{
    Layout = "_LayoutAdmin";
    var cultura = new System.Globalization.CultureInfo("es-ES");
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700);">Notificaciones</h1>
            <p class="text-muted mb-0">Centro de notificaciones y alertas del sistema.</p>
        </div>
        <form asp-action="MarcarTodasComoLeidas" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary" style="border-radius: 8px;">
                <i class="bi bi-check2-all me-2"></i>Marcar todas como leídas
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center gap-2"
         style="border-radius: 10px; font-size: 0.9rem; background: #f0fdf4; color: #166534;">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-0">
                @if (Model.Notificaciones.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notificacion in Model.Notificaciones)
                        {
                            <div class="list-group-item border-0 p-4 border-bottom @(notificacion.Leida ? "bg-opacity-10" : "")"
                                 style="background: @(notificacion.Leida ? "#f8fafc" : "white");">
                                <div class="d-flex gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width: 40px; height: 40px; background: @notificacion.ColorIcono; color: @notificacion.ColorTexto;">
                                        <i class="bi @notificacion.Icono"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="fw-bold mb-0">@(notificacion.Leida ? "" : "🔴 ")@notificacion.Titulo</h6>
                                            <small class="text-muted">@GetTiempoTranscurrido(notificacion.Fecha)</small>
                                        </div>
                                        <p class="text-muted small mb-2">@notificacion.Mensaje</p>
                                        <div class="d-flex gap-2">
                                            @if (!string.IsNullOrEmpty(notificacion.UrlAccion))
                                            {
                                                <a href="@notificacion.UrlAccion" class="btn btn-sm btn-primary" style="border-radius: 6px;">
                                                    Ver Detalles
                                                </a>
                                            }
                                            <form asp-action="MarcarComoLeida" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@notificacion.Id" />
                                                <input type="hidden" name="tipo" value="@notificacion.Tipo" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px;">
                                                    Marcar como leída
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-bell-slash" style="font-size: 4rem; color: #cbd5e1;"></i>
                        <h5 class="fw-bold mt-3 mb-2">No hay notificaciones</h5>
                        <p class="text-muted mb-0">No hay notificaciones pendientes en este momento</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Panel Lateral -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="color: #0f172a;">Resumen</h5>

                <div class="d-flex justify-content-between align-items-center mb-3 pb-3" style="border-bottom: 1px solid #e2e8f0;">
                    <span class="text-muted small">Sin leer</span>
                    <span class="badge bg-primary rounded-pill px-3">@Model.TotalSinLeer</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 pb-3" style="border-bottom: 1px solid #e2e8f0;">
                    <span class="text-muted small">Citas pendientes</span>
                    <span class="badge bg-warning rounded-pill px-3">@Model.TotalCitasPendientes</span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Resultados nuevos</span>
                    <span class="badge bg-success rounded-pill px-3">@Model.TotalResultadosNuevos</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="color: #0f172a;">Configuración</h5>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="notificacionesEmail" checked>
                    <label class="form-check-label small" for="notificacionesEmail">
                        Notificaciones por email
                    </label>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="notificacionesPush" checked>
                    <label class="form-check-label small" for="notificacionesPush">
                        Notificaciones push
                    </label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="notificacionesSonido">
                    <label class="form-check-label small" for="notificacionesSonido">
                        Sonido de alerta
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTiempoTranscurrido(DateTime fecha)
    {
        var tiempo = DateTime.Now - fecha;

        if (tiempo.TotalMinutes < 1)
            return "Ahora mismo";
        else if (tiempo.TotalMinutes < 60)
            return $"Hace {(int)tiempo.TotalMinutes} minuto{((int)tiempo.TotalMinutes > 1 ? "s" : "")}";
        else if (tiempo.TotalHours < 24)
            return $"Hace {(int)tiempo.TotalHours} hora{((int)tiempo.TotalHours > 1 ? "s" : "")}";
        else if (tiempo.TotalDays < 7)
            return $"Hace {(int)tiempo.TotalDays} día{((int)tiempo.TotalDays > 1 ? "s" : "")}";
        else
            return fecha.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES"));
    }
}