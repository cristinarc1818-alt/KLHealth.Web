@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString().ToLower();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString().ToLower();
    var userName = User.Identity?.Name ?? "Usuario";
    var userRole = User.IsInRole("Administrador") ? "Administrador" : "Médico";
    var userInitial = userName.Split(' ').Select(n => n[0]).Take(2).Aggregate("", (a, c) => a + c).ToUpper();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - K & L Health</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site-layouts.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <div class="sidebar-brand">
                    <span class="sidebar-brand-name">K & L Health</span>
                    <span class="sidebar-brand-sub">Siempre a tu disposición</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <ul class="sidebar-menu">
                    <li class="sidebar-item">
                        <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-link @(currentController == "admin" && currentAction == "dashboard" ? "active" : "")">
                            <i class="bi bi-grid-fill"></i>
                            <span>Panel de Control</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "AdminCitas")" class="sidebar-link @(currentController == "admincitas" ? "active" : "")">
                            <i class="bi bi-calendar-event-fill"></i>
                            <span>Citas</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "AdminPacientes")" class="sidebar-link @(currentController == "adminpacientes" ? "active" : "")">
                            <i class="bi bi-people-fill"></i>
                            <span>Pacientes</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "AdminMedicos")" class="sidebar-link @(currentController == "adminmedicos" ? "active" : "")">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>Médicos</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "ServiciosMedicos")" class="sidebar-link @(currentController == "serviciosmedicos" ? "active" : "")">
                            <i class="bi bi-plus-circle-fill"></i>
                            <span>Servicios Médicos</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "HistorialMedicoAdmin")" class="sidebar-link @(currentController == "historialmedicoadmin" ? "active" : "")">
                            <i class="bi bi-file-earmark-medical-fill"></i>
                            <span>Historias Clínicas</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "ResultadosAdmin")" class="sidebar-link @(currentController == "resultadosadmin" ? "active" : "")">
                            <i class="bi bi-clipboard-data-fill"></i>
                            <span>Resultados</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "NotificacionesAdmin")" class="sidebar-link @(currentController == "notificacionesadmin" ? "active" : "")">
                            <i class="bi bi-bell-fill"></i>
                            <span>Notificaciones</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "PerfilAdmin")" class="sidebar-link @(currentController == "perfiladmin" ? "active" : "")">
                            <i class="bi bi-person-circle"></i>
                            <span>Mi Perfil</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- PERFIL DEL USUARIO AL FINAL DEL SIDEBAR -->
            <div style="padding: 0.75rem 1rem; border-top: 1px solid #e5e7eb; display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 38px; height: 38px; min-width: 38px; border-radius: 50%; overflow: hidden; background: #dbeafe; flex-shrink: 0;">
                    <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=100&h=100&fit=crop&crop=face"
                         alt="@userName"
                         style="width: 38px; height: 38px; object-fit: cover; display: block;">
                </div>
                <div style="flex: 1; min-width: 0; overflow: hidden;">
                    <div style="font-size: 0.82rem; font-weight: 600; color: #0f172a; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@userName</div>
                    <div style="font-size: 0.7rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@userRole</div>
                </div>
            </div>

            <!-- CERRAR SESIÓN -->
            <div style="padding: 0.75rem 1rem; border-top: 1px solid #e5e7eb;">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" style="width: 100%; border: none; background: none; cursor: pointer; display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1rem; color: #dc2626; font-size: 0.875rem; font-weight: 500; border-radius: 8px; text-decoration: none;">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Cerrar sesión</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="main-content">
            <!-- NAVBAR -->
            <header class="navbar-top">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <i class="bi bi-list"></i>
                </button>

                <div class="navbar-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Buscar pacientes, doctores o registros..." />
                </div>

                <div class="navbar-actions">
                    <button class="navbar-icon-btn" title="Notificaciones">
                        <i class="bi bi-bell"></i>
                        <span class="navbar-badge"></span>
                    </button>
                    <button class="navbar-icon-btn" title="Ayuda">
                        <i class="bi bi-question-circle"></i>
                    </button>
                    <button class="navbar-icon-btn" title="Aplicaciones">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </button>

                    <div class="navbar-user">
                        <div class="navbar-user-avatar">@userInitial</div>
                        <div class="navbar-user-info">
                            <span class="navbar-user-name">@userName</span>
                            <span class="navbar-user-role">@userRole</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- CONTENIDO DE LA PÁGINA -->
            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('show');
            }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>