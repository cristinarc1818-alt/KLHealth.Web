@model KLHealth.Web.Models.Entities.ResultadoMedico
@{
    Layout = "_LayoutPaciente";
    var cultura = new System.Globalization.CultureInfo("es-ES");
}

<!-- Header con botón de retorno -->
<div class="mb-4">
    <a href="@Url.Action("Index", "Resultados")" class="btn btn-outline-secondary mb-3" style="border-radius: 8px; border-color: #e2e8f0;">
        <i class="bi bi-arrow-left me-2"></i>Volver a Resultados
    </a>

    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.8rem; color: #0f172a; letter-spacing: -0.5px;">Informe Médico</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Detalle oficial del estudio realizado.</p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" style="border-radius: 8px;">
                <i class="bi bi-printer me-2"></i>Imprimir
            </button>
            <a href="@Url.Action("Descargar", "Resultados", new { id = Model.Id })" class="btn btn-primary" style="background: #1e3a8a; border-color: #1e3a8a; border-radius: 8px;">
                <i class="bi bi-download me-2"></i>Descargar PDF
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Columna Principal: Documento Clínico -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
            <!-- Encabezado del Documento -->
            <div class="card-header border-0 py-4 px-4" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1" style="color: #1e3a8a; font-size: 1.5rem;">K & L Health</h4>
                        <small class="text-muted">Grupo de Salud Integral</small>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small">ID INFORME</div>
                        <div class="fw-bold" style="color: #0f172a;">XR-@Model.Id.ToString("D5")</div>
                        <div class="text-muted small mt-1">FECHA: @Model.Fecha.ToString("dd MMM yyyy", cultura).ToUpper()</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- Datos del Paciente y Médico -->
                <div class="row mb-4 pb-4" style="border-bottom: 1px solid #e2e8f0;">
                    <div class="col-md-6">
                        <div class="small text-muted text-uppercase fw-bold mb-1">Paciente</div>
                        <div class="fw-bold" style="font-size: 1.1rem; color: #0f172a;">@ViewData["NombrePaciente"]</div>
                        <div class="small text-muted">ID: KLH-8829</div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="small text-muted text-uppercase fw-bold mb-1">Médico Responsable</div>
                        <div class="fw-bold" style="font-size: 1.1rem; color: #0f172a;">@(Model.Medico?.Titulo ?? "Dr.") @(Model.Medico?.Usuario?.NombreCompleto ?? "No asignado")</div>
                        <div class="small text-muted">@(Model.Medico?.Especialidad?.Nombre ?? "Medicina General")</div>
                    </div>
                </div>

                <!-- Título del Estudio -->
                <h3 class="fw-bold mb-4" style="color: #1e3a8a; font-size: 1.4rem; border-left: 4px solid #1e3a8a; padding-left: 1rem;">
                    @(Model.NombreExamen ?? Model.Tipo)
                </h3>

                <!-- Hallazgos Clínicos (Usando la columna Descripcion) -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-3" style="font-size: 1.05rem; color: #0f172a;">
                        <i class="bi bi-clipboard2-pulse me-2" style="color: #1e3a8a;"></i>HALLAZGOS CLÍNICOS
                    </h5>
                    <p class="text-muted" style="font-size: 0.95rem; line-height: 1.7;">
                        @(Model.Descripcion ?? "No hay detalles disponibles para este estudio.")
                    </p>
                </div>

                <!-- Impresión / Diagnóstico -->
                <div class="mb-4 p-3" style="background: #eff6ff; border-radius: 8px; border-left: 4px solid #1e3a8a;">
                    <h6 class="fw-bold mb-2" style="color: #1e3a8a; font-size: 0.9rem;">IMPRESIÓN / DIAGNÓSTICO</h6>
                    <p class="mb-0 fw-semibold" style="color: #0f172a; font-size: 1rem;">
                        Estudio de @(Model.Tipo) sin anomalías significativas. Valores dentro de los rangos de referencia.
                    </p>
                </div>

                <!-- Firma Digital -->
                <div class="mt-5 pt-4" style="border-top: 1px solid #e2e8f0;">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="small text-muted mb-1">Firmado digitalmente por:</div>
                            <div class="fw-bold" style="font-size: 1.1rem; color: #0f172a;">@(Model.Medico?.Titulo ?? "Dr.") @(Model.Medico?.Usuario?.NombreCompleto ?? "No asignado")</div>
                            <div class="small text-muted">@(Model.Medico?.Especialidad?.Nombre ?? "Medicina General") - Lic. @(Model.Medico?.NumeroLicencia ?? "N/A")</div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <i class="bi bi-patch-check-fill" style="font-size: 3rem; color: #1e3a8a; opacity: 0.8;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Lateral: Información Adicional -->
    <div class="col-lg-4">
        <!-- Estado del Informe -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="font-size: 0.9rem; color: #64748b;">ESTADO DEL INFORME</h6>
                @if (Model.Pendiente)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: #fef3c7; color: #92400e;">
                            <i class="bi bi-hourglass-split" style="font-size: 1.2rem;"></i>
                        </div>
                        <div>
                            <div class="fw-bold" style="color: #92400e;">En Revisión</div>
                            <div class="small text-muted">Pendiente de validación</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: #dcfce7; color: #166534;">
                            <i class="bi bi-check-circle-fill" style="font-size: 1.2rem;"></i>
                        </div>
                        <div>
                            <div class="fw-bold" style="color: #166534;">Finalizado</div>
                            <div class="small text-muted">Informe oficial disponible</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Detalles del Estudio -->
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="font-size: 0.9rem; color: #64748b;">DETALLES DEL ESTUDIO</h6>

                <div class="mb-3">
                    <div class="small text-muted mb-1">Tipo de Estudio</div>
                    <div class="fw-semibold" style="color: #0f172a;">@Model.Tipo</div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted mb-1">Fecha de Realización</div>
                    <div class="fw-semibold" style="color: #0f172a;">@Model.Fecha.ToString("dd 'de' MMMM, yyyy", cultura)</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ArchivoUrl))
                {
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Archivo Adjunto</div>
                        <a href="@Model.ArchivoUrl" target="_blank" class="btn btn-sm btn-outline-primary w-100" style="border-radius: 8px;">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Ver Archivo Original
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>