@model KLHealth.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión - K & L Health";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
      :root {
    --primary-blue: #60a5fa;
    --primary-dark: #3b82f6;
    --primary-light: #93c5fd;
    --bg-field: #f8f7fc;
    --text-dark: #1a1a2e;
    --text-muted: #6b7280;
    --border-light: #e5e7eb;
}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            background: #fafafa;
        }
        
        .login-page {
            display: flex;
            min-height: 100vh;
        }
        
        /* Panel Izquierdo - Simplificado y Centrado */
        .branding-panel {
            flex: 1;
            background: var(--primary-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            color: white;
            position: relative;
        }
        
        .branding-content {
            max-width: 480px;
            text-align: center;
        }
        
        .branding-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.75rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 1.25rem;
        }
        
        .branding-content p {
            font-size: 1.05rem;
            line-height: 1.6;
            opacity: 0.95;
            margin-bottom: 2.5rem;
        }
        
        .feature-cards {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }
        
        .feature-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            flex: 1;
            max-width: 200px;
        }
        
        .feature-card i {
            font-size: 1.75rem;
            margin-bottom: 0.6rem;
            display: block;
        }
        
        .feature-card span {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        
        /* Panel Derecho */
        .form-panel {
            flex: 1;
            background: white;
            display: flex;
            flex-direction: column;
            padding: 2.5rem 3rem;
        }
        
        .form-container {
            max-width: 440px;
            width: 100%;
            margin: 0 auto;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .logo-header {
            margin-bottom: 1.5rem;
        }
        
        .logo-header h2 {
            font-family: 'Playfair Display', serif;
            color: var(--primary-blue);
            font-size: 1.5rem;
            font-weight: 700;
        }
        
        .form-header {
            margin-bottom: 1.5rem;
        }
        
        .form-header h3 {
            font-family: 'Playfair Display', serif;
            color: var(--text-dark);
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .form-header p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        
        .role-selector {
            background: #f3f4f6;
            border-radius: 10px;
            padding: 0.3rem;
            margin-bottom: 1.5rem;
            display: flex;
            gap: 0.2rem;
        }
        
        .role-selector .btn-check:checked + .btn {
            background-color: var(--primary-blue);
            color: white;
            box-shadow: 0 2px 6px rgba(0, 71, 171, 0.25);
        }
        
        .role-selector .btn {
            flex: 1;
            border-radius: 8px;
            border: none;
            padding: 0.6rem 1rem;
            font-weight: 500;
            font-size: 0.875rem;
            transition: all 0.2s ease;
            background: transparent;
            color: var(--text-muted);
        }
        
        .form-label-custom {
            font-weight: 500;
            color: var(--text-dark);
            font-size: 0.875rem;
            margin-bottom: 0.4rem;
            display: block;
        }
        
        .input-wrapper {
            background: var(--bg-field);
            border: 1px solid var(--border-light);
            border-radius: 10px;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            transition: all 0.2s ease;
            margin-bottom: 1rem;
        }
        
        .input-wrapper:focus-within {
            border-color: var(--primary-blue);
            background: white;
            box-shadow: 0 0 0 3px rgba(0, 71, 171, 0.08);
        }
        
        .input-wrapper i {
            color: var(--text-muted);
            font-size: 1rem;
        }
        
        .input-wrapper input {
            border: none;
            background: transparent;
            flex: 1;
            font-size: 0.9rem;
            color: var(--text-dark);
            outline: none;
        }
        
        .input-wrapper input::placeholder {
            color: #9ca3af;
        }
        
        .toggle-password {
            cursor: pointer;
            color: var(--text-muted);
            background: none;
            border: none;
            padding: 0;
            font-size: 1rem;
        }
        
        .toggle-password:hover {
            color: var(--primary-blue);
        }
        
        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        
        .form-check-custom {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .form-check-custom input[type="checkbox"] {
            width: 16px;
            height: 16px;
            border: 1.5px solid var(--border-light);
            border-radius: 4px;
            cursor: pointer;
        }
        
        .form-check-custom input[type="checkbox"]:checked {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
        }
        
        .form-check-custom label {
            font-size: 0.875rem;
            color: var(--text-dark);
            cursor: pointer;
        }
        
        .link-forgot {
            color: var(--primary-blue);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
        }
        
        .link-forgot:hover {
            text-decoration: underline;
        }
        
        .btn-login {
            background: var(--primary-blue);
            color: white;
            border: none;
            padding: 0.875rem;
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: 10px;
            width: 100%;
            transition: all 0.2s ease;
            margin-bottom: 1.25rem;
        }
        
        .btn-login:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 71, 171, 0.25);
        }
        
        .register-link {
            text-align: center;
            font-size: 0.875rem;
            color: var(--text-muted);
        }
        
        .register-link a {
            color: var(--primary-blue);
            text-decoration: none;
            font-weight: 600;
        }
        
        .register-link a:hover {
            text-decoration: underline;
        }
        
        .form-footer {
            margin-top: auto;
            padding-top: 2rem;
            text-align: center;
        }
        
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 1.25rem;
            margin-bottom: 0.75rem;
        }
        
        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.8rem;
        }
        
        .footer-links a:hover {
            color: var(--primary-blue);
        }
        
        .footer-center {
            margin-bottom: 0.5rem;
        }
        
        .footer-center a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.8rem;
        }
        
        .footer-copyright {
            color: #9ca3af;
            font-size: 0.75rem;
        }
        
        .alert-custom {
            border-radius: 10px;
            border: none;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }
        
        .alert-success-custom {
            background: #f0fdf4;
            color: #166534;
            border-left: 3px solid #22c55e;
        }
        
        .alert-danger-custom {
            background: #fef2f2;
            color: #991b1b;
            border-left: 3px solid #ef4444;
        }
        
        .validation-error {
            color: #ef4444;
            font-size: 0.75rem;
            margin-top: -0.5rem;
            margin-bottom: 0.75rem;
        }
        
        @@media (max-width: 992px) {
            .branding-panel {
                display: none;
            }
            
            .form-panel {
                padding: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="branding-panel">
            <div class="branding-content">
                <h1>Su salud, conectada.</h1>
                <p>Acceda de forma segura a sus citas, registros médicos y servicios de salud en cualquier momento.</p>
                
                <div class="feature-cards">
                    <div class="feature-card">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Acceso Seguro</span>
                    </div>
                    <div class="feature-card">
                        <i class="bi bi-file-earmark-medical-fill"></i>
                        <span>Registros Médicos</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="form-panel">
            <div class="form-container">
                <div class="logo-header">
                    <h2>K & L Health</h2>
                </div>
                
                <div class="form-header">
                    <h3>Bienvenido de nuevo</h3>
                    <p>Inicie sesión para continuar a su portal de salud.</p>
                </div>
                
                <div class="role-selector">
                    <input type="radio" class="btn-check" name="roleVisual" id="rolePaciente" autocomplete="off" checked>
                    <label class="btn" for="rolePaciente">Paciente</label>

                    <input type="radio" class="btn-check" name="roleVisual" id="roleMedico" autocomplete="off">
                    <label class="btn" for="roleMedico">Médico</label>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-custom alert-success-custom">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom"></div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label-custom">Correo electrónico</label>
                        <div class="input-wrapper">
                            <i class="bi bi-envelope-fill"></i>
                            <input asp-for="Email" placeholder="nombre@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label-custom">Contraseña</label>
                        <div class="input-wrapper">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="Password" type="password" placeholder="••••••••" id="passwordInput" />
                            <button type="button" class="toggle-password" onclick="togglePassword()">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="validation-error"></span>
                    </div>

                    <div class="form-options">
                        <div class="form-check-custom">
                            <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                            <label for="rememberMe">Recordarme</label>
                        </div>
                        <a href="#" class="link-forgot">¿Olvidó su contraseña?</a>
                    </div>

                    <button type="submit" class="btn-login">
                        Iniciar sesión
                    </button>

                    <div class="register-link">
                        ¿No tiene una cuenta? <a asp-action="Register">Crear cuenta</a>
                    </div>
                </form>
                
                <div class="form-footer">
                    <div class="footer-links">
                        <a href="#">Política de privacidad</a>
                        <a href="#">Términos de servicio</a>
                    </div>
                    <div class="footer-center">
                        <a href="#" class="link-forgot">Centro de ayuda</a>
                    </div>
                    <div class="footer-copyright">
                        © 2026 K & L Health. Todos los derechos reservados.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        function togglePassword() {
            var passwordInput = document.getElementById('passwordInput');
            var toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>