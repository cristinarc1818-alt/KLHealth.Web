@model KLHealth.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta - K & L Health";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary-blue: #60a5fa;
                --primary-dark: #3b82f6;
                --primary-light: #93c5fd;
                --bg-field: #f8f7fc;
                --text-dark: #1a1a2e;
                --text-muted: #6b7280;
                --border-light: #e5e7eb;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                min-height: 100vh;
                background: #fafafa;
            }

            .register-page {
                display: flex;
                min-height: 100vh;
            }

            .branding-panel {
                flex: 1;
                background: var(--primary-blue);
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 3rem;
                color: white;
                position: relative;
            }

            .branding-content {
                max-width: 480px;
                margin: 0 auto;
            }

            .branding-logo {
                font-family: 'Playfair Display', serif;
                font-size: 1.75rem;
                font-weight: 700;
                margin-bottom: 2rem;
            }

            .branding-content h1 {
                font-family: 'Playfair Display', serif;
                font-size: 2.5rem;
                font-weight: 700;
                line-height: 1.2;
                margin-bottom: 1rem;
            }

            .branding-content p {
                font-size: 1rem;
                line-height: 1.6;
                opacity: 0.95;
            }

            .trust-badge {
                position: absolute;
                bottom: 2rem;
                left: 3rem;
                background: rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 50px;
                padding: 0.6rem 1.25rem;
                display: flex;
                align-items: center;
                gap: 0.6rem;
                font-size: 0.85rem;
                font-weight: 500;
            }

                .trust-badge .dot {
                    width: 8px;
                    height: 8px;
                    background: #22c55e;
                    border-radius: 50%;
                }

            .form-panel {
                flex: 1;
                background: white;
                display: flex;
                flex-direction: column;
                padding: 2.5rem 3rem;
                overflow-y: auto;
            }

            .form-container {
                max-width: 520px;
                width: 100%;
                margin: 0 auto;
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .form-header {
                text-align: center;
                margin-bottom: 2rem;
            }

                .form-header h2 {
                    font-family: 'Playfair Display', serif;
                    color: var(--text-dark);
                    font-size: 2rem;
                    font-weight: 700;
                    margin-bottom: 0.5rem;
                }

                .form-header p {
                    color: var(--text-muted);
                    font-size: 0.9rem;
                }

            .info-box {
                background: #eff6ff;
                border-left: 3px solid var(--primary-blue);
                border-radius: 10px;
                padding: 1rem 1.25rem;
                margin-bottom: 1.75rem;
                display: flex;
                gap: 0.75rem;
                align-items: flex-start;
            }

                .info-box i {
                    color: var(--primary-blue);
                    font-size: 1.1rem;
                    margin-top: 0.1rem;
                }

                .info-box p {
                    font-size: 0.85rem;
                    color: var(--text-dark);
                    margin: 0;
                    line-height: 1.5;
                }

            .form-label-custom {
                font-weight: 500;
                color: var(--text-dark);
                font-size: 0.85rem;
                margin-bottom: 0.35rem;
                display: block;
            }

            .input-wrapper {
                background: var(--bg-field);
                border: 1px solid var(--border-light);
                border-radius: 10px;
                padding: 0.65rem 0.9rem;
                display: flex;
                align-items: center;
                gap: 0.6rem;
                transition: all 0.2s ease;
                margin-bottom: 0.9rem;
            }

                .input-wrapper:focus-within {
                    border-color: var(--primary-blue);
                    background: white;
                    box-shadow: 0 0 0 3px rgba(0, 71, 171, 0.08);
                }

                .input-wrapper i {
                    color: var(--text-muted);
                    font-size: 0.95rem;
                }

                .input-wrapper input,
                .input-wrapper select {
                    border: none;
                    background: transparent;
                    flex: 1;
                    font-size: 0.875rem;
                    color: var(--text-dark);
                    outline: none;
                }

                    .input-wrapper input::placeholder {
                        color: #9ca3af;
                    }

            .form-group {
                margin-bottom: 0.25rem;
            }

            .terms-check {
                display: flex;
                align-items: flex-start;
                gap: 0.6rem;
                margin: 1.25rem 0;
            }

                .terms-check input[type="checkbox"] {
                    width: 16px;
                    height: 16px;
                    border: 1.5px solid var(--border-light);
                    border-radius: 4px;
                    cursor: pointer;
                    margin-top: 0.1rem;
                }

                    .terms-check input[type="checkbox"]:checked {
                        background-color: var(--primary-blue);
                        border-color: var(--primary-blue);
                    }

                .terms-check label {
                    font-size: 0.85rem;
                    color: var(--text-dark);
                    cursor: pointer;
                    line-height: 1.5;
                }

                .terms-check a {
                    color: var(--primary-blue);
                    text-decoration: none;
                    font-weight: 600;
                }

                    .terms-check a:hover {
                        text-decoration: underline;
                    }

            .btn-register {
                background: var(--primary-blue);
                color: white;
                border: none;
                padding: 0.875rem;
                font-weight: 600;
                font-size: 0.95rem;
                border-radius: 10px;
                width: 100%;
                transition: all 0.2s ease;
                margin-bottom: 1.25rem;
            }

                .btn-register:hover {
                    background: var(--primary-dark);
                    transform: translateY(-1px);
                    box-shadow: 0 4px 12px rgba(0, 71, 171, 0.25);
                }

            .login-link {
                text-align: center;
                font-size: 0.875rem;
                color: var(--text-muted);
                margin-bottom: 1.5rem;
            }

                .login-link a {
                    color: var(--primary-blue);
                    text-decoration: none;
                    font-weight: 600;
                }

                    .login-link a:hover {
                        text-decoration: underline;
                    }

            .form-footer {
                margin-top: auto;
                text-align: center;
            }

            .footer-copyright {
                color: #9ca3af;
                font-size: 0.75rem;
            }

            .alert-custom {
                border-radius: 10px;
                border: none;
                padding: 0.75rem 1rem;
                margin-bottom: 1rem;
                font-size: 0.875rem;
            }

            .alert-danger-custom {
                background: #fef2f2;
                color: #991b1b;
                border-left: 3px solid #ef4444;
            }

            .validation-error {
                color: #ef4444;
                font-size: 0.75rem;
                margin-top: -0.5rem;
                margin-bottom: 0.5rem;
            }

            @@media (max-width: 992px) {
                .branding-panel {
                    display: none;
                }

                .form-panel {
                    padding: 2rem;
                }

                .trust-badge {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <div class="register-page">
        <div class="branding-panel">
            <div class="branding-content">
                <div class="branding-logo">K & L Health</div>
                <h1>Cree su cuenta de paciente.</h1>
                <p>Reserve citas, vea registros médicos, reciba notificaciones y gestione su salud en línea.</p>
            </div>

            <div class="trust-badge">
                <div class="dot"></div>
                <span>Con la confianza de más de 50,000 pacientes</span>
            </div>
        </div>

        <div class="form-panel">
            <div class="form-container">
                <div class="form-header">
                    <h2>Crea tu cuenta</h2>
                    <p>Únase a K & L Health y acceda a todos sus servicios de salud en línea.</p>
                </div>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom"></div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="Nombre" class="form-label-custom">Nombre</label>
                            <div class="input-wrapper">
                                <i class="bi bi-person-fill"></i>
                                <input asp-for="Nombre" placeholder="Juan" />
                            </div>
                            <span asp-validation-for="Nombre" class="validation-error"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Apellido" class="form-label-custom">Apellido</label>
                            <div class="input-wrapper">
                                <i class="bi bi-person-fill"></i>
                                <input asp-for="Apellido" placeholder="Pérez" />
                            </div>
                            <span asp-validation-for="Apellido" class="validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="Email" class="form-label-custom">Correo electrónico</label>
                            <div class="input-wrapper">
                                <i class="bi bi-envelope-fill"></i>
                                <input asp-for="Email" type="email" placeholder="juan.perez@ejemplo.com" />
                            </div>
                            <span asp-validation-for="Email" class="validation-error"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Telefono" class="form-label-custom">Número de teléfono</label>
                            <div class="input-wrapper">
                                <i class="bi bi-telephone-fill"></i>
                                <input asp-for="Telefono" placeholder="+1 (555) 000-0000" />
                            </div>
                            <span asp-validation-for="Telefono" class="validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="FechaNacimiento" class="form-label-custom">Fecha de nacimiento</label>
                            <div class="input-wrapper">
                                <i class="bi bi-calendar-fill"></i>
                                <input asp-for="FechaNacimiento" type="date" />
                            </div>
                            <span asp-validation-for="FechaNacimiento" class="validation-error"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Genero" class="form-label-custom">Género</label>
                            <div class="input-wrapper">
                                <i class="bi bi-people-fill"></i>
                                <select asp-for="Genero">
                                    <option value="">Seleccionar género</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Femenino">Femenino</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            <span asp-validation-for="Genero" class="validation-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="NumeroIdentificacion" class="form-label-custom">
                            Identificación Nacional <small class="text-muted">(Opcional)</small>
                        </label>
                        <div class="input-wrapper">
                            <i class="bi bi-card-heading"></i>
                            <input asp-for="NumeroIdentificacion" placeholder="Número de identificación" />
                        </div>
                    </div>

                    <!-- SECCIÓN MODIFICADA PARA VALIDACIONES JS -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="Password" class="form-label-custom">Contraseña</label>
                            <div class="input-wrapper">
                                <i class="bi bi-lock-fill"></i>
                                <input asp-for="Password" type="password" id="Password" placeholder="••••••••" />
                            </div>
                            <div id="password-feedback" class="small mt-1" style="min-height: 20px;"></div>
                            <span asp-validation-for="Password" class="validation-error"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="ConfirmPassword" class="form-label-custom">Confirmar contraseña</label>
                            <div class="input-wrapper">
                                <i class="bi bi-shield-lock-fill"></i>
                                <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" placeholder="••••••••" />
                            </div>
                            <div id="confirm-password-feedback" class="small mt-1" style="min-height: 20px;"></div>
                            <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
                        </div>
                    </div>

                    <div class="terms-check">
                        <input asp-for="AceptaTerminos" type="checkbox" id="acceptTerms" />
                        <label for="acceptTerms">
                            Acepto los <a href="#">Términos de servicio</a> y la <a href="#">Política de privacidad</a>.
                        </label>
                    </div>
                    <span asp-validation-for="AceptaTerminos" class="validation-error d-block mb-3"></span>

                    <button type="submit" class="btn-register">
                        Crear cuenta
                    </button>

                    <div class="login-link">
                        ¿Ya tiene una cuenta? <a asp-action="Login">Iniciar sesión</a>
                    </div>
                </form>

                <div class="info-box">
                    <i class="bi bi-info-circle-fill"></i>
                    <p>Las cuentas de médicos son creadas por los administradores del hospital. Esta página de registro es solo para pacientes.</p>
                </div>

                <div class="form-footer">
                    <div class="footer-copyright">
                        © 2026 K & L Health. Todos los derechos reservados.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- AGREGADO: Referencia a nuestro script de validaciones personalizadas -->
    <script src="~/js/validaciones.js"></script>
</body>
</html>