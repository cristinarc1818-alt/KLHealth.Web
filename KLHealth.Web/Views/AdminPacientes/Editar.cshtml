@model KLHealth.Web.Models.ViewModels.PacienteFormViewModel
@{
    Layout = "_LayoutAdmin";
}

<!-- Header -->
<div class="mb-4">
    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700); letter-spacing: -0.5px;">Editar Paciente</h1>
    <p class="text-muted mb-0" style="font-size: 0.9rem;">Actualiza la información del paciente.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0">
            <div class="card-body p-4">
                <form asp-action="Editar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 10px;"></div>

                    <!-- Nombre Completo -->
                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold" style="font-size: 0.9rem;">
                            <i class="bi bi-person me-1"></i>Nombre completo
                        </label>
                        <input asp-for="NombreCompleto" class="form-control"
                               style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold" style="font-size: 0.9rem;">
                            <i class="bi bi-envelope me-1"></i>Correo electrónico
                        </label>
                        <input asp-for="Email" type="email" class="form-control"
                               style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Número de Identificación -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumeroIdentificacion" class="form-label fw-semibold" style="font-size: 0.9rem;">
                                <i class="bi bi-card-heading me-1"></i>Número de identificación
                            </label>
                            <input asp-for="NumeroIdentificacion" class="form-control"
                                   style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                            <span asp-validation-for="NumeroIdentificacion" class="text-danger small"></span>
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label fw-semibold" style="font-size: 0.9rem;">
                                <i class="bi bi-telephone me-1"></i>Teléfono
                            </label>
                            <input asp-for="Telefono" class="form-control"
                                   style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Fecha de Nacimiento -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaNacimiento" class="form-label fw-semibold" style="font-size: 0.9rem;">
                                <i class="bi bi-calendar me-1"></i>Fecha de nacimiento
                            </label>
                            <input asp-for="FechaNacimiento" type="date" class="form-control"
                                   style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                            <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                        </div>

                        <!-- Género -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Genero" class="form-label fw-semibold" style="font-size: 0.9rem;">
                                <i class="bi bi-people me-1"></i>Género
                            </label>
                            <select asp-for="Genero" class="form-select"
                                    style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                                <option value="">Seleccionar género</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </select>
                            <span asp-validation-for="Genero" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Contraseña (opcional al editar) -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold" style="font-size: 0.9rem;">
                                <i class="bi bi-lock me-1"></i>Nueva contraseña <small class="text-muted">(opcional)</small>
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Dejar en blanco para mantener la actual"
                                   style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirmar Contraseña -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold" style="font-size: 0.9rem;">
                                <i class="bi bi-shield-lock me-1"></i>Confirmar contraseña
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••"
                                   style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary px-4 py-2"
                                style="background: var(--blue-900); border-color: var(--blue-900); border-radius: 10px; font-weight: 600;">
                            <i class="bi bi-check-circle me-2"></i>Guardar Cambios
                        </button>
                        <a href="@Url.Action("Index", "AdminPacientes")" class="btn btn-outline-secondary px-4 py-2"
                           style="border-radius: 10px;">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Panel lateral -->
    <div class="col-lg-4">
        <div class="card border-0" style="background: #eff6ff; border-radius: 12px; border-left: 4px solid var(--blue-900);">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-2" style="font-size: 0.9rem; color: var(--blue-900);">
                    <i class="bi bi-info-circle me-1"></i>Información
                </h6>
                <p class="mb-0 small" style="font-size: 0.82rem; color: #475569; line-height: 1.6;">
                    Deja el campo de contraseña en blanco si no deseas cambiarla. Solo se actualizará si proporcionas una nueva.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}