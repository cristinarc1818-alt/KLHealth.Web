@model KLHealth.Web.Models.Entities.Paciente
@{
    Layout = "_LayoutAdmin";
    var cultura = new System.Globalization.CultureInfo("es-ES");

    // Obtener las citas del ViewBag
    var citas = ViewBag.Citas as List<KLHealth.Web.Models.Entities.Cita>;

    // LÓGICA SEGURA PARA INICIALES - Centralizada
    var nombreCompleto = Model.Usuario?.NombreCompleto ?? "Usuario";
    var palabras = nombreCompleto.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    var inicial1 = palabras.Length > 0 && palabras[0].Length > 0 ? palabras[0][0] : '?';
    var inicial2 = palabras.Length > 1 && palabras[1].Length > 0 ? palabras[1][0] : '?';
    var iniciales = $"{inicial1}{inicial2}".ToUpper();
}

<!-- Header -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: var(--blue-700); letter-spacing: -0.5px;">
                Detalles del Paciente
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Información completa y historial de citas.</p>
        </div>
        <a href="@Url.Action("Index", "AdminPacientes")" class="btn btn-outline-secondary px-4 py-2"
           style="border-radius: 10px;">
            <i class="bi bi-arrow-left me-2"></i>Volver a la lista
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Información Personal -->
    <div class="col-lg-4">
        <div class="card border-0">
            <div class="card-body p-4 text-center">
                <div class="avatar-circle mb-3 mx-auto" style="width: 100px; height: 100px; font-size: 2.5rem;">
                    @iniciales
                </div>
                <h4 class="fw-bold mb-1">@Model.Usuario?.NombreCompleto</h4>
                <p class="text-muted mb-3">Paciente registrado</p>

                <div class="text-start mt-4">
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Número de Identificación</div>
                        <div class="fw-semibold">@Model.NumeroIdentificacion</div>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Correo electrónico</div>
                        <div class="fw-semibold">@Model.Usuario?.Email</div>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Teléfono</div>
                        <div class="fw-semibold">@(Model.Usuario?.Telefono ?? "No registrado")</div>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Fecha de nacimiento</div>
                        <div class="fw-semibold">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Género</div>
                        <div class="fw-semibold">No especificado</div>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Fecha de registro</div>
                        <div class="fw-semibold">@Model.Usuario?.FechaRegistro.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a href="@Url.Action("Editar", "AdminPacientes", new { id = Model.Id })"
                       class="btn btn-primary py-2"
                       style="background: var(--blue-900); border-color: var(--blue-900); border-radius: 10px;">
                        <i class="bi bi-pencil me-2"></i>Editar paciente
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de Citas -->
    <div class="col-lg-8">
        <div class="card border-0">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-calendar3 me-2"></i>Historial de Citas
                </h5>

                @if (citas != null && citas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Fecha</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Médico</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Especialidad</th>
                                    <th style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cita in citas)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark" style="font-size: 0.85rem;">
                                                @cita.FechaHoraInicio.ToString("dd MMM yyyy", cultura)
                                            </div>
                                            <div class="text-muted" style="font-size: 0.72rem;">
                                                @cita.FechaHoraInicio.ToString("hh:mm tt")
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark" style="font-size: 0.85rem;">
                                                @cita.Medico?.Titulo @cita.Medico?.Usuario?.NombreCompleto
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill"
                                                  style="font-size: 0.72rem;">
                                                @cita.Medico?.Especialidad?.Nombre
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill px-3 py-2
                                                @(cita.Estado == "Confirmada" ? "bg-success bg-opacity-10 text-success" :
                                                  cita.Estado == "Pendiente" ? "bg-warning bg-opacity-10 text-warning" :
                                                  cita.Estado == "Completada" ? "bg-primary bg-opacity-10 text-primary" :
                                                  "bg-danger bg-opacity-10 text-danger")"
                                                  style="font-size: 0.72rem;">
                                                @cita.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (citas.Count >= 10)
                    {
                        <div class="text-center mt-3">
                            <small class="text-muted">
                                Mostrando las 10 citas más recientes
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x" style="font-size: 3rem; color: var(--text-light); opacity: 0.4;"></i>
                        <p class="text-muted mt-3 mb-0">Este paciente no tiene citas registradas.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: var(--blue-100);
            color: var(--blue-700);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 2.5rem;
        }
    </style>
}