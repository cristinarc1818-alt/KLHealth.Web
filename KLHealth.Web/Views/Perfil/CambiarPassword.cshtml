@model KLHealth.Web.Models.ViewModels.CambiarPasswordViewModel
@{
    Layout = "_LayoutPaciente";
}

<!-- Header -->
<div class="mb-4">
    <a href="@Url.Action("Index", "Perfil")" class="btn btn-outline-secondary mb-3" style="border-radius: 8px; border-color: #e2e8f0;">
        <i class="bi bi-arrow-left me-2"></i>Volver al Perfil
    </a>
    
    <h1 class="fw-bold mb-1" style="font-size: 2rem; color: #0f172a; letter-spacing: -0.5px;">Cambiar Contraseña</h1>
    <p class="text-muted mb-0" style="font-size: 0.95rem;">Actualice su contraseña de acceso al portal.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <form asp-action="CambiarPassword" method="post" id="formCambiarPassword">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UsuarioId" value="@ViewContext.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 10px;"></div>

                    <div class="mb-4">
                        <h5 class="fw-bold mb-3" style="color: #0f172a; font-size: 0.9rem;">
                            <i class="bi bi-lock me-2" style="color: #1e3a8a;"></i>Seguridad
                        </h5>

                        <!-- Contraseña Actual -->
                        <div class="mb-3">
                            <label asp-for="PasswordActual" class="form-label fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-key me-1"></i>Contraseña Actual
                            </label>
                            <div class="input-group" style="border-radius: 10px; overflow: hidden;">
                                <input asp-for="PasswordActual" type="password" class="form-control" placeholder="••••••••" id="passwordActual"
                                       style="border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('passwordActual', 'iconActual')" 
                                        style="border-left: none; background: white;">
                                    <i class="bi bi-eye" id="iconActual"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                        </div>

                        <!-- Nueva Contraseña -->
                        <div class="mb-3">
                            <label asp-for="NuevaPassword" class="form-label fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-shield-lock me-1"></i>Nueva Contraseña
                            </label>
                            <div class="input-group" style="border-radius: 10px; overflow: hidden;">
                                <input asp-for="NuevaPassword" type="password" class="form-control" placeholder="Mínimo 8 caracteres" id="nuevaPassword"
                                       style="border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('nuevaPassword', 'iconNueva')" 
                                        style="border-left: none; background: white;">
                                    <i class="bi bi-eye" id="iconNueva"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                            <div id="password-strength" class="mt-2 small" style="min-height: 20px;"></div>
                        </div>

                        <!-- Confirmar Contraseña -->
                        <div class="mb-3">
                            <label asp-for="ConfirmarPassword" class="form-label fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-shield-check me-1"></i>Confirmar Nueva Contraseña
                            </label>
                            <div class="input-group" style="border-radius: 10px; overflow: hidden;">
                                <input asp-for="ConfirmarPassword" type="password" class="form-control" placeholder="••••••••" id="confirmarPassword"
                                       style="border: 1px solid #e2e8f0; padding: 0.75rem 1rem;">
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('confirmarPassword', 'iconConfirmar')" 
                                        style="border-left: none; background: white;">
                                    <i class="bi bi-eye" id="iconConfirmar"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                            <div id="password-match" class="mt-2 small" style="min-height: 20px;"></div>
                        </div>
                    </div>

                    <!-- Botones de acción -->
                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn px-4 py-2" style="background: #1e3a8a; color: white; border-radius: 10px; font-weight: 600;">
                            <i class="bi bi-check-circle me-2"></i>Cambiar Contraseña
                        </button>
                        <a href="@Url.Action("Index", "Perfil")" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Panel lateral informativo -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 14px; background: #eff6ff; border-left: 4px solid #1e3a8a;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-2" style="color: #1e3a8a; font-size: 0.9rem;">
                    <i class="bi bi-shield-fill-check me-1"></i>Requisitos de Seguridad
                </h6>
                <ul class="mb-0 small" style="color: #475569; line-height: 1.8; font-size: 0.85rem; padding-left: 1.2rem;">
                    <li>Mínimo 8 caracteres</li>
                    <li>Al menos una letra mayúscula (A-Z)</li>
                    <li>Al menos una letra minúscula (a-z)</li>
                    <li>Al menos un número (0-9)</li>
                    <li>Al menos un carácter especial (!&#64;&#36;&#37;^&amp;*)</li>
                </ul>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-3" style="border-radius: 14px; background: #fef3c7; border-left: 4px solid #f59e0b;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-2" style="color: #92400e; font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle me-1"></i>Importante
                </h6>
                <p class="mb-0 small" style="color: #78350f; line-height: 1.6; font-size: 0.85rem;">
                    Después de cambiar su contraseña, deberá iniciar sesión nuevamente con sus nuevas credenciales en todos sus dispositivos.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Función para mostrar/ocultar contraseña
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        // Validación de fortaleza en tiempo real
        document.getElementById('nuevaPassword').addEventListener('input', function() {
            var password = this.value;
            var strengthDiv = document.getElementById('password-strength');
            
            if (password.length === 0) {
                strengthDiv.innerHTML = '';
                return;
            }
            
            var errors = [];
            if (password.length < 8) errors.push("8 caracteres");
            if (!/[A-Z]/.test(password)) errors.push("mayúscula");
            if (!/[a-z]/.test(password)) errors.push("minúscula");
            if (!/[0-9]/.test(password)) errors.push("número");
            if (!/[^A-Za-z0-9]/.test(password)) errors.push("carácter especial");
            
            if (errors.length === 0) {
                strengthDiv.innerHTML = '<span style="color: #166534;"><i class="bi bi-check-circle-fill"></i> Contraseña segura</span>';
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
            } else {
                strengthDiv.innerHTML = '<span style="color: #dc2626;"><i class="bi bi-exclamation-circle-fill"></i> Faltan: ' + errors.join(', ') + '</span>';
                this.classList.remove('is-valid');
                this.classList.add('is-invalid');
            }
        });

        // Validación de coincidencia
        document.getElementById('confirmarPassword').addEventListener('input', function() {
            var password = document.getElementById('nuevaPassword').value;
            var confirm = this.value;
            var matchDiv = document.getElementById('password-match');
            
            if (confirm.length === 0) {
                matchDiv.innerHTML = '';
                return;
            }
            
            if (password !== confirm) {
                matchDiv.innerHTML = '<span style="color: #dc2626;"><i class="bi bi-x-circle-fill"></i> Las contraseñas no coinciden</span>';
                this.classList.remove('is-valid');
                this.classList.add('is-invalid');
            } else {
                matchDiv.innerHTML = '<span style="color: #166534;"><i class="bi bi-check-circle-fill"></i> Las contraseñas coinciden</span>';
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
            }
        });
    </script>
}