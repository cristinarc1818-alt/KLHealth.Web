@model List<KLHealth.Web.Models.Entities.Notificacion>
@{
    Layout = "_LayoutPaciente";
    var cultura = new System.Globalization.CultureInfo("es-ES");
}

<!-- Header -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.8rem; color: #0f172a; letter-spacing: -0.5px;">Notificaciones y Recordatorios</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Gestiona tus notificaciones del sistema y crea recordatorios personales.</p>
        </div>
        <a href="@Url.Action("Crear", "Notificaciones")" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2" style="background: #1e3a8a; border-color: #1e3a8a; border-radius: 10px; font-size: 0.9rem; font-weight: 500;">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo Recordatorio</span>
        </a>
    </div>
</div>

<!-- Mensajes de Éxito/Error -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center gap-2" style="border-radius: 10px; font-size: 0.9rem; background: #f0fdf4; color: #166534;">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 d-flex align-items-center gap-2" style="border-radius: 10px; font-size: 0.9rem; background: #fef2f2; color: #991b1b;">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- Lista de Notificaciones -->
@if (Model.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var notif in Model)
        {
            <div class="notificacion-card @(notif.Leida ? "opacity-75" : "")">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center gap-3">
                            <div class="notificacion-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="background: #dbeafe; color: #1e3a8a; width: 44px; height: 44px;">
                                <i class="bi @notif.Icono"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1 @(notif.Leida ? "text-muted" : "text-dark")" style="font-size: 1rem;">
                                    @notif.Titulo
                                    @if (!notif.Leida)
                                    {
                                        <span class="badge rounded-pill ms-2" style="background: #1e3a8a; font-size: 0.6rem;">NUEVO</span>
                                    }
                                </h5>
                                <div class="text-muted" style="font-size: 0.85rem; line-height: 1.4;">@notif.Mensaje</div>
                                <div class="mt-1" style="font-size: 0.75rem; color: #94a3b8;">
                                    <i class="bi bi-clock me-1"></i>@notif.Fecha.ToString("dd MMMM yyyy, hh:mm tt", cultura)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <div class="d-flex gap-2 justify-content-md-end flex-wrap">
                            <!-- UPDATE: Marcar leída -->
                            <form method="post" action="@Url.Action("MarcarLeida", "Notificaciones", new { id = notif.Id })" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px; font-size: 0.82rem; border-color: #e2e8f0;">
                                    <i class="bi @(notif.Leida ? "bi-envelope" : "bi-envelope-open") me-1"></i>
                                    @(notif.Leida ? "Marcar no leída" : "Marcar leída")
                                </button>
                            </form>

                            <!-- DELETE: Eliminación física -->
                            <form method="post" action="@Url.Action("Eliminar", "Notificaciones", new { id = notif.Id })" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este registro permanentemente de la base de datos?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; font-size: 0.82rem; border-color: #fee2e2; color: #dc2626;">
                                    <i class="bi bi-trash me-1"></i>Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state-container">
        <div class="empty-state-icon">
            <i class="bi bi-bell-slash"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">No tienes notificaciones</h4>
        <p class="text-muted mb-4" style="font-size: 0.95rem;">
            Crea tu primer recordatorio personal o espera las notificaciones del sistema.
        </p>
        <a href="@Url.Action("Crear", "Notificaciones")" class="btn btn-primary px-4 py-2" style="background: #1e3a8a; border-color: #1e3a8a; border-radius: 10px;">
            <i class="bi bi-plus-lg me-2"></i>Crear Recordatorio
        </a>
    </div>
}

@section Styles {
    <style>
        .notificacion-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            transition: all 0.2s ease;
        }

            .notificacion-card:hover {
                box-shadow: 0 4px 12px rgba(30, 58, 138, 0.06);
                border-color: #cbd5e1;
            }

        .empty-state-container {
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            border-radius: 16px;
            text-align: center;
            padding: 4rem 2rem;
        }

        .empty-state-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: white;
            box-shadow: 0 4px 16px rgba(30, 58, 138, 0.1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            color: #1e3a8a;
            font-size: 1.8rem;
        }
    </style>
}